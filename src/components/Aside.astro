---
import Github3 from "./icons/github3.astro";
import ThemeToggle from "./ThemeToggle.jsx";
import Fiverr from "./icons/fiverr.astro";
---

<div
  class="fixed bottom-6 left-1/2 -translate-x-1/2 z-[100] md:bottom-auto md:top-1/2 md:left-6 md:-translate-y-1/2 md:translate-x-0 group"
>
  <div
    class="flex flex-row md:flex-col items-center gap-2 p-2 rounded-3xl bg-white/70 dark:bg-zinc-900/70 backdrop-blur-2xl border border-zinc-200 dark:border-zinc-800 shadow-2xl shadow-emerald-500/10 transition-all duration-500 hover:scale-[1.02]"
  >
    <!-- Theme Toggle -->
    <div
      class="p-1 rounded-2xl transition-colors hover:bg-zinc-100 dark:hover:bg-white/5"
    >
      <ThemeToggle client:load />
    </div>

    <!-- Divider -->
    <div
      class="w-px h-6 bg-zinc-200 dark:bg-zinc-800 mx-1 md:w-6 md:h-px md:my-1"
    >
    </div>

    <!-- Main Action: Email with Tooltip -->
    <div class="relative group">
      <a
        id="copy-email"
        data-email="blasvernazza123@gmail.com"
        href="mailto:blasvernazza123@gmail.com"
        class="flex items-center justify-center gap-2 px-4 py-2 md:px-2 md:py-4 rounded-2xl bg-zinc-900 dark:bg-zinc-50 text-white dark:text-zinc-900 font-bold text-sm transition-all duration-300 hover:bg-emerald-600 dark:hover:bg-emerald-400 dark:hover:text-black group/btn overflow-hidden relative"
      >
        <span class="relative z-10 md:hidden font-outfit">Contactame</span>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="3"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="relative z-10 transition-transform group-hover/btn:scale-110 md:group-hover/btn:translate-y-[-2px]"
        >
          <rect width="20" height="16" x="2" y="4" rx="2"></rect>
          <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
        </svg>

        <!-- Shine effect -->
        <div
          class="absolute inset-0 -translate-x-full group-hover/btn:translate-x-full transition-transform duration-700 bg-gradient-to-r from-transparent via-white/20 to-transparent"
        >
        </div>
      </a>

      <!-- Premium Tooltip (Centrado Infalible) -->
      <div
        class="absolute bottom-full mb-4 left-1/2 -translate-x-1/2 md:inset-y-1.5 md:left-full md:ml-3 md:bottom-auto md:mb-0 md:translate-x-1 flex items-center justify-center opacity-0 pointer-events-none group-hover:opacity-100 transition-all duration-300 scale-95 group-hover:scale-100 z-50"
      >
        <div
          class="px-4 py-2 rounded-2xl bg-zinc-900 dark:bg-white text-white dark:text-zinc-900 text-[10px] font-black uppercase tracking-widest shadow-xl whitespace-nowrap"
        >
          Envíame un email 🚀
        </div>
      </div>
    </div>

    <!-- Secondary Action: Fiverr -->
    <a
      href="https://www.fiverr.com/blas_vernazza?public_mode=true"
      target="_blank"
      class="p-2 rounded-2xl text-zinc-500 dark:text-zinc-400 hover:text-emerald-500 dark:hover:text-emerald-400 transition-colors"
      title="Fiverr Profile"
    >
      <Fiverr class="size-6" />
    </a>
  </div>
</div>

<script>
  // Support View Transitions
  document.addEventListener("astro:page-load", initCopy);
</script>
