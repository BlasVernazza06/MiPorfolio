---
import Github3 from "./icons/github3.astro";
import ThemeToggle from "./ThemeToggle.jsx";
import LinkedIn from "./icons/linkedin.astro";
import { getTranslations } from "@/lib/i18n";

const { lang = "es" } = Astro.props;
const t = getTranslations(lang);

const pathname = Astro.url.pathname;
const targetLangLink = pathname.startsWith('/en')
  ? pathname.replace(/^\/en/, '') || '/'
  : `/en${pathname === '/' ? '' : pathname}`;
---

<div
  class="fixed bottom-6 left-1/2 -translate-x-1/2 z-[100] md:bottom-auto md:top-1/2 md:left-6 md:-translate-y-1/2 md:translate-x-0"
>
  <!-- Inner float container with iOS-style glassmorphism and premium spring hover -->
  <div
    class="flex flex-row md:flex-col items-center gap-2 p-2 rounded-full glass-dock transition-all duration-500 hover:scale-[1.03] animate-aside-float"
  >
    
    <!-- Command Palette (Search) Trigger -->
    <div class="relative group/tooltip">
      <button
        id="aside-search-btn"
        aria-label="Buscar en el sitio"
        class="flex items-center justify-center p-2.5 rounded-full text-zinc-500 dark:text-zinc-400 hover:text-emerald-500 dark:hover:text-emerald-400 hover:bg-emerald-500/10 dark:hover:bg-emerald-400/10 transition-all duration-[400ms] cubic-bezier(0.175, 0.885, 0.32, 1.275) hover:scale-115"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-500 group-hover:rotate-12">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </button>
      <!-- Tooltip -->
      <div class="absolute bottom-full mb-3 left-1/2 -translate-x-1/2 origin-bottom md:bottom-auto md:mb-0 md:left-full md:ml-3 md:top-1/2 md:-translate-y-1/2 md:translate-x-0 md:origin-left opacity-0 scale-95 pointer-events-none group-hover/tooltip:opacity-100 group-hover/tooltip:scale-100 transition-all duration-300 z-50">
        <div class="px-3 py-1.5 rounded-xl bg-zinc-950/90 dark:bg-white/90 text-white dark:text-zinc-950 text-[11px] font-bold tracking-tight shadow-xl whitespace-nowrap border border-white/10 dark:border-black/5 backdrop-blur-md">
          <span>{t.aside.search}</span>
          <span class="px-1.5 py-0.5 rounded text-[9px] bg-zinc-800 dark:bg-zinc-200 text-zinc-400 dark:text-zinc-600 font-mono">Ctrl+K</span>
        </div>
      </div>
    </div>

    <!-- Divider -->
    <div class="w-px h-6 bg-zinc-200/50 dark:bg-zinc-800/50 mx-0.5 md:w-6 md:h-px md:my-0.5"></div>

    <!-- GitHub -->
    <div class="relative group/tooltip">
      <a
        href="https://github.com/BlasVernazza06"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Perfil de GitHub"
        class="flex items-center justify-center p-2.5 rounded-full text-zinc-500 dark:text-zinc-400 hover:text-emerald-500 dark:hover:text-emerald-400 hover:bg-emerald-500/10 dark:hover:bg-emerald-400/10 transition-all duration-[400ms] cubic-bezier(0.175, 0.885, 0.32, 1.275) hover:scale-115"
      >
        <Github3 class="size-5 transition-transform duration-300 group-hover:scale-105" />
      </a>
      <!-- Tooltip -->
      <div class="absolute bottom-full mb-3 left-1/2 -translate-x-1/2 origin-bottom md:bottom-auto md:mb-0 md:left-full md:ml-3 md:top-1/2 md:-translate-y-1/2 md:translate-x-0 md:origin-left opacity-0 scale-95 pointer-events-none group-hover/tooltip:opacity-100 group-hover/tooltip:scale-100 transition-all duration-300 z-50">
        <div class="px-3 py-1.5 rounded-xl bg-zinc-950/90 dark:bg-white/90 text-white dark:text-zinc-950 text-[11px] font-bold tracking-tight shadow-xl whitespace-nowrap border border-white/10 dark:border-black/5 backdrop-blur-md">
          {t.aside.github}
        </div>
      </div>
    </div>

    <!-- LinkedIn -->
    <div class="relative group/tooltip">
      <a
        href="https://www.linkedin.com/in/blas-vernazza-888588355/"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Perfil de LinkedIn"
        class="flex items-center justify-center p-2.5 rounded-full text-zinc-500 dark:text-zinc-400 hover:text-emerald-500 dark:hover:text-emerald-400 hover:bg-emerald-500/10 dark:hover:bg-emerald-400/10 transition-all duration-[400ms] cubic-bezier(0.175, 0.885, 0.32, 1.275) hover:scale-115"
      >
        <LinkedIn class="size-5 transition-transform duration-300 group-hover:scale-105" />
      </a>
      <!-- Tooltip -->
      <div class="absolute bottom-full mb-3 left-1/2 -translate-x-1/2 origin-bottom md:bottom-auto md:mb-0 md:left-full md:ml-3 md:top-1/2 md:-translate-y-1/2 md:translate-x-0 md:origin-left opacity-0 scale-95 pointer-events-none group-hover/tooltip:opacity-100 group-hover/tooltip:scale-100 transition-all duration-300 z-50">
        <div class="px-3 py-1.5 rounded-xl bg-zinc-950/90 dark:bg-white/90 text-white dark:text-zinc-950 text-[11px] font-bold tracking-tight shadow-xl whitespace-nowrap border border-white/10 dark:border-black/5 backdrop-blur-md">
          {t.aside.linkedin}
        </div>
      </div>
    </div>

    <!-- Divider -->
    <div class="w-px h-6 bg-zinc-200/50 dark:bg-zinc-800/50 mx-0.5 md:w-6 md:h-px md:my-0.5"></div>

    <!-- Main Action: Interactive Copy Email -->
    <div class="relative group/tooltip group-email">
      <button
        id="aside-copy-email"
        data-email="blasvernazza123@gmail.com"
        aria-label="Copiar email de contacto"
        class="flex items-center justify-center p-2.5 rounded-full bg-zinc-900 dark:bg-zinc-50 text-white dark:text-zinc-900 transition-all duration-[400ms] cubic-bezier(0.175, 0.885, 0.32, 1.275) hover:bg-emerald-600 dark:hover:bg-emerald-400 hover:scale-115 relative overflow-hidden group/btn"
      >
        <span class="relative z-10 flex items-center justify-center size-5">
          <!-- Mail Icon -->
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="mail-icon transition-all duration-300 ease-out scale-100 opacity-100"
          >
            <rect width="20" height="16" x="2" y="4" rx="2"></rect>
            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
          </svg>
          <!-- Success Check Icon -->
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="3"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="check-icon absolute transition-all duration-300 ease-out scale-0 opacity-0 text-white dark:text-zinc-900"
          >
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
        </span>
        
        <!-- Shine effect -->
        <span
          class="absolute inset-0 -translate-x-full group-hover/btn:translate-x-full transition-transform duration-700 bg-gradient-to-r from-transparent via-white/20 to-transparent"
        >
        </span>
      </button>

      <!-- Tooltip -->
      <div class="absolute bottom-full mb-3 left-1/2 -translate-x-1/2 origin-bottom md:bottom-auto md:mb-0 md:left-full md:ml-3 md:top-1/2 md:-translate-y-1/2 md:translate-x-0 md:origin-left opacity-0 scale-95 pointer-events-none group-hover/tooltip:opacity-100 group-hover/tooltip:scale-100 transition-all duration-300 z-50">
        <div class="px-3 py-1.5 rounded-xl bg-zinc-950/90 dark:bg-white/90 text-white dark:text-zinc-950 text-[11px] font-bold tracking-tight shadow-xl whitespace-nowrap border border-white/10 dark:border-black/5 flex flex-col gap-0.5 backdrop-blur-md">
          <span id="email-tooltip-title" class="font-black" data-copied-text={t.aside.emailCopied} data-original-text={t.aside.emailCopy}>{t.aside.emailCopy}</span>
          <span class="text-[9px] opacity-65 font-medium">blasvernazza123@gmail.com</span>
        </div>
      </div>
    </div>

    <!-- Theme Toggle -->
    <div class="relative group/tooltip">
      <ThemeToggle client:load />
      <!-- Tooltip -->
      <div class="absolute bottom-full mb-3 left-1/2 -translate-x-1/2 origin-bottom md:bottom-auto md:mb-0 md:left-full md:ml-3 md:top-1/2 md:-translate-y-1/2 md:translate-x-0 md:origin-left opacity-0 scale-95 pointer-events-none group-hover/tooltip:opacity-100 group-hover/tooltip:scale-100 transition-all duration-300 z-50">
        <div class="px-3 py-1.5 rounded-xl bg-zinc-950/90 dark:bg-white/90 text-white dark:text-zinc-950 text-[11px] font-bold tracking-tight shadow-xl whitespace-nowrap border border-white/10 dark:border-black/5 backdrop-blur-md">
          {t.aside.theme}
        </div>
      </div>
    </div>

    <!-- Divider -->
    <div class="w-px h-6 bg-zinc-200/50 dark:bg-zinc-800/50 mx-0.5 md:w-6 md:h-px md:my-0.5"></div>

    <!-- Language Toggle Switcher (Circular flags with prominent ES/EN corner badge) -->
    <div class="relative group/tooltip">
      <a
        id="lang-toggle"
        href={targetLangLink}
        aria-label={lang === "en" ? "Cambiar a Español" : "Switch to English"}
        class="relative flex items-center justify-center p-2.5 rounded-full text-zinc-500 dark:text-zinc-400 hover:bg-emerald-500/10 dark:hover:bg-emerald-400/10 transition-all duration-[400ms] cubic-bezier(0.175, 0.885, 0.32, 1.275) hover:scale-115 cursor-pointer"
      >
        {lang === "en" ? (
          <!-- Spain Flag (Switch to Spanish) -->
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" class="rounded-full overflow-hidden shadow-sm border border-zinc-200/20 dark:border-zinc-800/20">
            <rect width="24" height="6" fill="#AD1519"/>
            <rect y="6" width="24" height="12" fill="#FABD00"/>
            <rect y="18" width="24" height="6" fill="#AD1519"/>
          </svg>
        ) : (
          <!-- UK flag / Union Jack (Switch to English) -->
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" class="rounded-full overflow-hidden shadow-sm border border-zinc-200/20 dark:border-zinc-800/20">
            <rect width="24" height="24" fill="#012169"/>
            <path d="M0 0 L24 24 M0 24 L24 0" stroke="#FFFFFF" stroke-width="3"/>
            <path d="M0 0 L24 24 M0 24 L24 0" stroke="#C8102E" stroke-width="1.5"/>
            <path d="M12 0 L12 24 M0 12 L24 12" stroke="#FFFFFF" stroke-width="5"/>
            <path d="M12 0 L12 24 M0 12 L24 12" stroke="#C8102E" stroke-width="3"/>
          </svg>
        )}
        <!-- Floating text indicator badge for language target (EN / ES) -->
        <span class="absolute -bottom-0.5 -right-0.5 flex items-center justify-center px-1 rounded bg-zinc-950 dark:bg-white text-[7px] font-black text-white dark:text-zinc-950 uppercase border border-zinc-850 dark:border-zinc-100/50 shadow-sm scale-90 tracking-tighter">
          {lang === "es" ? "EN" : "ES"}
        </span>
      </a>
      <!-- Tooltip -->
      <div class="absolute bottom-full mb-3 left-1/2 -translate-x-1/2 origin-bottom md:bottom-auto md:mb-0 md:left-full md:ml-3 md:top-1/2 md:-translate-y-1/2 md:translate-x-0 md:origin-left opacity-0 scale-95 pointer-events-none group-hover/tooltip:opacity-100 group-hover/tooltip:scale-100 transition-all duration-300 z-50">
        <div class="px-3 py-1.5 rounded-xl bg-zinc-950/90 dark:bg-white/90 text-white dark:text-zinc-950 text-[11px] font-bold tracking-tight shadow-xl whitespace-nowrap border border-white/10 dark:border-black/5 backdrop-blur-md">
          {t.aside.lang}
        </div>
      </div>
    </div>

  </div>
</div>

<style>
  /* Premium Glassmorphic Dock Container */
  .glass-dock {
    background: rgba(255, 255, 255, 0.70);
    backdrop-filter: blur(24px) saturate(180%);
    -webkit-backdrop-filter: blur(24px) saturate(180%);
    border: 1px solid rgba(0, 0, 0, 0.08);
    box-shadow: 
      0 1px 1px rgba(255, 255, 255, 0.8) inset,
      0 8px 32px rgba(0, 0, 0, 0.04);
  }

  :global(.dark) .glass-dock {
    background: rgba(10, 10, 12, 0.60);
    backdrop-filter: blur(24px) saturate(180%);
    -webkit-backdrop-filter: blur(24px) saturate(180%);
    border: 1px solid rgba(255, 255, 255, 0.05);
    box-shadow: 
      0 1px 0px rgba(255, 255, 255, 0.06) inset,
      0 20px 40px rgba(0, 0, 0, 0.4),
      0 0 40px rgba(16, 185, 129, 0.03);
  }

  /* React to hover of parent dock: make borders slightly more vibrant */
  .glass-dock:hover {
    border-color: rgba(16, 185, 129, 0.2);
  }
  :global(.dark) .glass-dock:hover {
    border-color: rgba(52, 211, 153, 0.15);
  }

  /* Vertical float animation */
  @keyframes asideFloat {
    0%, 100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-6px);
    }
  }

  .animate-aside-float {
    animation: asideFloat 6s ease-in-out infinite;
  }

  .animate-aside-float:hover {
    animation-play-state: paused;
  }

  /* Style states for the Copy Email button */
  .group-email.copied button {
    background-color: #10b981; /* emerald-500 */
    transform: scale(1.05);
  }
  
  :global(.dark) .group-email.copied button {
    background-color: #34d399; /* emerald-400 */
  }
  
  .group-email.copied .mail-icon {
    transform: scale(0);
    opacity: 0;
  }

  .group-email.copied .check-icon {
    transform: scale(1) !important;
    opacity: 1 !important;
  }

  /* Critical UX Fix: Hide tooltip when theme toggle menu is open */
  .group\/tooltip:has(.menu-open) > div:last-child {
    opacity: 0 !important;
    pointer-events: none !important;
    display: none !important;
  }
</style>

<script>
  function initAside() {
    // 1. Search button functionality
    const searchBtn = document.getElementById("aside-search-btn");
    if (searchBtn) {
      searchBtn.addEventListener("click", () => {
        window.dispatchEvent(new CustomEvent("toggle-command-palette"));
      });
    }

    // 2. Email copying logic
    const copyEmailBtn = document.getElementById("aside-copy-email");
    const emailGroup = copyEmailBtn?.closest(".group-email");
    const tooltipTitle = document.getElementById("email-tooltip-title");

    if (copyEmailBtn && emailGroup && tooltipTitle) {
      // Direct click copies to clipboard
      copyEmailBtn.addEventListener("click", async () => {
        try {
          const email = copyEmailBtn.getAttribute("data-email") || "";
          await navigator.clipboard.writeText(email);

          const copiedText = tooltipTitle.getAttribute("data-copied-text") || "¡Copiado con éxito! 🎉";
          const originalText = tooltipTitle.getAttribute("data-original-text") || "Copiar email 📋";

          // Trigger visual feedback
          emailGroup.classList.add("copied");
          tooltipTitle.innerText = copiedText;

          setTimeout(() => {
            emailGroup.classList.remove("copied");
            tooltipTitle.innerText = originalText;
          }, 2000);
        } catch (err) {
          console.error("Failed to copy email:", err);
          // Fallback to mailto link if copy fails
          window.location.href = `mailto:${copyEmailBtn.getAttribute("data-email")}`;
        }
      });

      // Context menu (right click) opens email client directly
      copyEmailBtn.addEventListener("contextmenu", (e) => {
        e.preventDefault();
        const email = copyEmailBtn.getAttribute("data-email");
        window.location.href = `mailto:${email}`;
      });
    }

    // 3. Language switcher URL hash preservation and LocalStorage sync
    const langToggle = document.getElementById("lang-toggle");
    if (langToggle) {
      langToggle.addEventListener("click", (e) => {
        e.preventDefault();
        const href = langToggle.getAttribute("href") || "";
        const hash = window.location.hash || "";

        // Sync preferred language manually when user toggles
        const isEnglishTarget = href.startsWith("/en");
        localStorage.setItem("preferred-language", isEnglishTarget ? "en" : "es");

        window.location.href = href + hash;
      });
    }
  }

  // Support Astro View Transitions
  document.addEventListener("astro:page-load", initAside);
</script>
