---
import Github3 from "./icons/github3.astro";
import ThemeToggle from "./ThemeToggle.jsx";
import LinkedIn from "./icons/linkedin.astro";
import { getTranslations } from "@/lib/i18n";

const { lang = "es" } = Astro.props;
const t = getTranslations(lang);

const pathname = Astro.url.pathname;
const targetLangLink = pathname.startsWith('/en')
  ? pathname.replace(/^\/en/, '') || '/'
  : `/en${pathname === '/' ? '' : pathname}`;
---

<!-- 
  THESIS: Un panel de herramientas editorial asimétrico con bordes angulares (rounded-xl/lg) 
  que parece sacado de un estudio de diseño o un CAD de lujo. 
  Menos border-radius, mayor separación lógica por segmentos y micro-indicadores activos al hover.
-->
<div
  class="fixed bottom-6 left-1/2 -translate-x-1/2 z-[100] md:bottom-auto md:top-1/2 md:left-6 md:-translate-y-1/2 md:translate-x-0"
>
  <div
    class="flex flex-row md:flex-col items-center gap-1.5 p-2 rounded-xl aside-panel border transition-all duration-300 shadow-2xl"
  >
    <!-- SEGMENTO 1: UTILIDADES (Buscar) -->
    <div class="flex flex-row md:flex-col gap-1">
      <div class="relative group/tooltip">
        <button
          id="aside-search-btn"
          aria-label="Buscar en el sitio"
          class="aside-btn relative flex items-center justify-center size-10 rounded-lg transition-all duration-300 hover:scale-105 active:scale-95"
        >
          <!-- Indicador activo de hover -->
          <span class="aside-indicator absolute left-0 top-1/2 -translate-y-1/2 w-[2px] h-0 bg-amber-500 transition-all duration-300 group-hover/tooltip:h-4 hidden md:block"></span>
          <span class="aside-indicator absolute bottom-0 left-1/2 -translate-x-1/2 h-[2px] w-0 bg-amber-500 transition-all duration-300 group-hover/tooltip:w-4 md:hidden"></span>
          
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="icon-svg transition-transform duration-300 group-hover/tooltip:rotate-6">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
        </button>
        <!-- Tooltip -->
        <div class="absolute bottom-full mb-3 left-1/2 -translate-x-1/2 origin-bottom md:bottom-auto md:mb-0 md:left-full md:ml-3 md:top-1/2 md:-translate-y-1/2 md:translate-x-0 md:origin-left opacity-0 scale-95 pointer-events-none group-hover/tooltip:opacity-100 group-hover/tooltip:scale-100 transition-all duration-300 z-50">
          <div class="px-2.5 py-1.5 rounded-lg bg-zinc-950/90 dark:bg-zinc-900/90 text-white dark:text-zinc-100 text-[11px] font-bold tracking-tight shadow-xl whitespace-nowrap border border-white/10 dark:border-white/5 backdrop-blur-md">
            <span>{t.aside.search}</span>
            <span class="px-1 py-0.5 rounded text-[8px] bg-zinc-800 dark:bg-zinc-700 text-zinc-400 dark:text-zinc-500 font-mono ml-1.5">Ctrl+K</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Divisor -->
    <div class="aside-sep w-px h-6 mx-0.5 md:w-6 md:h-px md:my-0.5"></div>

    <!-- SEGMENTO 2: REDES -->
    <div class="flex flex-row md:flex-col gap-1">
      <!-- GitHub -->
      <div class="relative group/tooltip">
        <a
          href="https://github.com/BlasVernazza06"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Perfil de GitHub"
          class="aside-btn relative flex items-center justify-center size-10 rounded-lg transition-all duration-300 hover:scale-105 active:scale-95"
        >
          <span class="aside-indicator absolute left-0 top-1/2 -translate-y-1/2 w-[2px] h-0 bg-amber-500 transition-all duration-300 group-hover/tooltip:h-4 hidden md:block"></span>
          <span class="aside-indicator absolute bottom-0 left-1/2 -translate-x-1/2 h-[2px] w-0 bg-amber-500 transition-all duration-300 group-hover/tooltip:w-4 md:hidden"></span>
          <Github3 class="size-4.5 icon-svg transition-transform duration-300 group-hover/tooltip:scale-105" />
        </a>
        <!-- Tooltip -->
        <div class="absolute bottom-full mb-3 left-1/2 -translate-x-1/2 origin-bottom md:bottom-auto md:mb-0 md:left-full md:ml-3 md:top-1/2 md:-translate-y-1/2 md:translate-x-0 md:origin-left opacity-0 scale-95 pointer-events-none group-hover/tooltip:opacity-100 group-hover/tooltip:scale-100 transition-all duration-300 z-50">
          <div class="px-2.5 py-1.5 rounded-lg bg-zinc-950/90 dark:bg-zinc-900/90 text-white dark:text-zinc-100 text-[11px] font-bold tracking-tight shadow-xl whitespace-nowrap border border-white/10 dark:border-white/5 backdrop-blur-md">
            {t.aside.github}
          </div>
        </div>
      </div>

      <!-- LinkedIn -->
      <div class="relative group/tooltip">
        <a
          href="https://www.linkedin.com/in/blas-vernazza-888588355/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Perfil de LinkedIn"
          class="aside-btn relative flex items-center justify-center size-10 rounded-lg transition-all duration-300 hover:scale-105 active:scale-95"
        >
          <span class="aside-indicator absolute left-0 top-1/2 -translate-y-1/2 w-[2px] h-0 bg-amber-500 transition-all duration-300 group-hover/tooltip:h-4 hidden md:block"></span>
          <span class="aside-indicator absolute bottom-0 left-1/2 -translate-x-1/2 h-[2px] w-0 bg-amber-500 transition-all duration-300 group-hover/tooltip:w-4 md:hidden"></span>
          <LinkedIn class="size-4.5 icon-svg transition-transform duration-300 group-hover/tooltip:scale-105" />
        </a>
        <!-- Tooltip -->
        <div class="absolute bottom-full mb-3 left-1/2 -translate-x-1/2 origin-bottom md:bottom-auto md:mb-0 md:left-full md:ml-3 md:top-1/2 md:-translate-y-1/2 md:translate-x-0 md:origin-left opacity-0 scale-95 pointer-events-none group-hover/tooltip:opacity-100 group-hover/tooltip:scale-100 transition-all duration-300 z-50">
          <div class="px-2.5 py-1.5 rounded-lg bg-zinc-950/90 dark:bg-zinc-900/90 text-white dark:text-zinc-100 text-[11px] font-bold tracking-tight shadow-xl whitespace-nowrap border border-white/10 dark:border-white/5 backdrop-blur-md">
            {t.aside.linkedin}
          </div>
        </div>
      </div>
    </div>

    <!-- Divisor -->
    <div class="aside-sep w-px h-6 mx-0.5 md:w-6 md:h-px md:my-0.5"></div>

    <!-- SEGMENTO 3: PREFERENCIAS & SISTEMA -->
    <div class="flex flex-row md:flex-col gap-1 items-center">
      <!-- Copiar Email -->
      <div class="relative group/tooltip group-email">
        <button
          id="aside-copy-email"
          data-email="blasvernazza123@gmail.com"
          aria-label="Copiar email de contacto"
          class="aside-email-btn flex items-center justify-center size-10 rounded-lg transition-all duration-300 hover:scale-105 active:scale-95 relative overflow-hidden"
        >
          <span class="relative z-10 flex items-center justify-center size-4.5">
            <!-- Icono Mail -->
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="mail-icon transition-all duration-300 ease-out scale-100 opacity-100"
            >
              <rect width="20" height="16" x="2" y="4" rx="2"></rect>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
            </svg>
            <!-- Icono Check -->
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="3"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="check-icon absolute transition-all duration-300 ease-out scale-0 opacity-0"
            >
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </span>
          <!-- Efecto brillo -->
          <span class="absolute inset-0 -translate-x-full hover-shine transition-transform duration-750 bg-gradient-to-r from-transparent via-white/10 to-transparent"></span>
        </button>
        <!-- Tooltip -->
        <div class="absolute bottom-full mb-3 left-1/2 -translate-x-1/2 origin-bottom md:bottom-auto md:mb-0 md:left-full md:ml-3 md:top-1/2 md:-translate-y-1/2 md:translate-x-0 md:origin-left opacity-0 scale-95 pointer-events-none group-hover/tooltip:opacity-100 group-hover/tooltip:scale-100 transition-all duration-300 z-50">
          <div class="px-2.5 py-1.5 rounded-lg bg-zinc-950/90 dark:bg-zinc-900/90 text-white dark:text-zinc-100 text-[11px] font-bold tracking-tight shadow-xl whitespace-nowrap border border-white/10 dark:border-white/5 flex flex-col gap-0.5 backdrop-blur-md">
            <span id="email-tooltip-title" class="font-black" data-copied-text={t.aside.emailCopied} data-original-text={t.aside.emailCopy}>{t.aside.emailCopy}</span>
            <span class="text-[9px] opacity-65 font-medium">blasvernazza123@gmail.com</span>
          </div>
        </div>
      </div>

      <!-- Theme Toggle -->
      <div class="relative group/tooltip">
        <ThemeToggle client:load />
        <!-- Tooltip -->
        <div class="absolute bottom-full mb-3 left-1/2 -translate-x-1/2 origin-bottom md:bottom-auto md:mb-0 md:left-full md:ml-3 md:top-1/2 md:-translate-y-1/2 md:translate-x-0 md:origin-left opacity-0 scale-95 pointer-events-none group-hover/tooltip:opacity-100 group-hover/tooltip:scale-100 transition-all duration-300 z-50">
          <div class="px-2.5 py-1.5 rounded-lg bg-zinc-950/90 dark:bg-zinc-900/90 text-white dark:text-zinc-100 text-[11px] font-bold tracking-tight shadow-xl whitespace-nowrap border border-white/10 dark:border-white/5 backdrop-blur-md">
            {t.aside.theme}
          </div>
        </div>
      </div>

      <!-- Language Toggle -->
      <div class="relative group/tooltip">
        <a
          id="lang-toggle"
          href={targetLangLink}
          aria-label={lang === "en" ? "Cambiar a Español" : "Switch to English"}
          class="lang-btn relative flex items-center justify-center size-10 rounded-lg transition-all duration-300 hover:scale-105 active:scale-95 cursor-pointer"
        >
          {lang === "en" ? (
            <!-- Spain Flag -->
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" class="rounded overflow-hidden shadow-sm border border-black/5 dark:border-white/10">
              <rect width="24" height="6" fill="#AD1519"/>
              <rect y="6" width="24" height="12" fill="#FABD00"/>
              <rect y="18" width="24" height="6" fill="#AD1519"/>
            </svg>
          ) : (
            <!-- UK flag -->
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" class="rounded overflow-hidden shadow-sm border border-black/5 dark:border-white/10">
              <rect width="24" height="24" fill="#012169"/>
              <path d="M0 0 L24 24 M0 24 L24 0" stroke="#FFFFFF" stroke-width="3"/>
              <path d="M0 0 L24 24 M0 24 L24 0" stroke="#C8102E" stroke-width="1.5"/>
              <path d="M12 0 L12 24 M0 12 L24 12" stroke="#FFFFFF" stroke-width="5"/>
              <path d="M12 0 L12 24 M0 12 L24 12" stroke="#C8102E" stroke-width="3"/>
            </svg>
          )}
          <!-- Badge EN/ES -->
          <span class="lang-badge absolute -bottom-0.5 -right-0.5 flex items-center justify-center px-1 rounded-[4px] text-[7px] font-black uppercase border shadow-sm scale-90 tracking-tighter">
            {lang === "es" ? "EN" : "ES"}
          </span>
        </a>
        <!-- Tooltip -->
        <div class="absolute bottom-full mb-3 left-1/2 -translate-x-1/2 origin-bottom md:bottom-auto md:mb-0 md:left-full md:ml-3 md:top-1/2 md:-translate-y-1/2 md:translate-x-0 md:origin-left opacity-0 scale-95 pointer-events-none group-hover/tooltip:opacity-100 group-hover/tooltip:scale-100 transition-all duration-300 z-50">
          <div class="px-2.5 py-1.5 rounded-lg bg-zinc-950/90 dark:bg-zinc-900/90 text-white dark:text-zinc-100 text-[11px] font-bold tracking-tight shadow-xl whitespace-nowrap border border-white/10 dark:border-white/5 backdrop-blur-md">
            {t.aside.lang}
          </div>
        </div>
      </div>
    </div>

  </div>
</div>

<style>
  /* ── ESTRUCTURA EDITORIAL DEL PANEL ── */
  .aside-panel {
    background: oklch(1 0.003 58 / 0.85);
    backdrop-filter: blur(20px) saturate(160%);
    -webkit-backdrop-filter: blur(20px) saturate(160%);
    border-color: oklch(0.88 0.025 52);
    /* Sombrado sutil */
    box-shadow: 
      0 1px 0px oklch(1 0.003 58) inset,
      0 10px 30px oklch(0.14 0.018 42 / 0.04);
  }

  :global(.dark) .aside-panel {
    background: oklch(0.14 0.014 38 / 0.85);
    border-color: oklch(0.22 0.020 38);
    box-shadow: 
      0 1px 0px oklch(1 0.003 58 / 0.03) inset,
      0 12px 36px oklch(0.10 0.012 38 / 0.35);
  }

  /* Divisor */
  .aside-sep {
    background-color: oklch(0.88 0.025 52 / 0.6);
  }
  :global(.dark) .aside-sep {
    background-color: oklch(0.22 0.020 38 / 0.6);
  }

  /* ── BOTONES DE ICONOS COMUNES (Bordes angulares) ── */
  .aside-btn {
    color: oklch(0.45 0.025 42);
    border: 1px solid transparent;
  }
  .aside-btn:hover {
    color: oklch(0.65 0.18 40);
    background: oklch(0.65 0.18 40 / 0.06);
    border-color: oklch(0.65 0.18 40 / 0.15);
  }

  :global(.dark) .aside-btn {
    color: oklch(0.75 0.012 52);
  }
  :global(.dark) .aside-btn:hover {
    color: oklch(0.72 0.17 44);
    background: oklch(0.72 0.17 44 / 0.08);
    border-color: oklch(0.72 0.17 44 / 0.2);
  }

  /* ── EMAIL BUTTON ── */
  .aside-email-btn {
    background: oklch(0.14 0.018 42);
    color: oklch(1 0.003 58);
  }
  .aside-email-btn:hover {
    background: oklch(0.55 0.16 36);
  }
  :global(.dark) .aside-email-btn {
    background: oklch(0.95 0.008 52);
    color: oklch(0.10 0.012 38);
  }
  :global(.dark) .aside-email-btn:hover {
    background: oklch(0.72 0.17 44);
  }

  /* ── BADGE DE IDIOMA ── */
  .lang-badge {
    background: oklch(0.14 0.018 42);
    color: oklch(1 0.003 58);
    border-color: oklch(0.14 0.018 42);
  }
  :global(.dark) .lang-badge {
    background: oklch(0.95 0.008 52);
    color: oklch(0.10 0.012 38);
    border-color: oklch(0.95 0.008 52);
  }
  .lang-btn:hover {
    background: oklch(0.65 0.18 40 / 0.08);
  }
  :global(.dark) .lang-btn:hover {
    background: oklch(0.72 0.17 44 / 0.08);
  }

  /* ── COPIED STATE ── */
  .group-email.copied button {
    background-color: oklch(0.65 0.18 40) !important;
    color: oklch(1 0.003 58) !important;
    transform: scale(1.03);
  }
  :global(.dark) .group-email.copied button {
    background-color: oklch(0.72 0.17 44) !important;
    color: oklch(0.10 0.012 38) !important;
  }
  .group-email.copied .mail-icon {
    transform: scale(0);
    opacity: 0;
  }
  .group-email.copied .check-icon {
    transform: scale(1) !important;
    opacity: 1 !important;
  }

  /* Tooltip hiding when menus open */
  .group\/tooltip:has(.menu-open) > div:last-child {
    opacity: 0 !important;
    pointer-events: none !important;
    display: none !important;
  }
</style>

<script>
  function initAside() {
    // 1. Search button
    const searchBtn = document.getElementById("aside-search-btn");
    if (searchBtn) {
      searchBtn.addEventListener("click", () => {
        window.dispatchEvent(new CustomEvent("toggle-command-palette"));
      });
    }

    // 2. Email copying
    const copyEmailBtn = document.getElementById("aside-copy-email");
    const emailGroup = copyEmailBtn?.closest(".group-email");
    const tooltipTitle = document.getElementById("email-tooltip-title");

    if (copyEmailBtn && emailGroup && tooltipTitle) {
      copyEmailBtn.addEventListener("click", async () => {
        try {
          const email = copyEmailBtn.getAttribute("data-email") || "";
          await navigator.clipboard.writeText(email);

          const copiedText = tooltipTitle.getAttribute("data-copied-text") || "¡Copiado! 🎉";
          const originalText = tooltipTitle.getAttribute("data-original-text") || "Copiar email";

          emailGroup.classList.add("copied");
          tooltipTitle.innerText = copiedText;

          setTimeout(() => {
            emailGroup.classList.remove("copied");
            tooltipTitle.innerText = originalText;
          }, 2000);
        } catch (err) {
          console.error("Failed to copy email:", err);
          window.location.href = `mailto:${copyEmailBtn.getAttribute("data-email")}`;
        }
      });
    }

    // 3. Language switcher
    const langToggle = document.getElementById("lang-toggle");
    if (langToggle) {
      langToggle.addEventListener("click", (e) => {
        e.preventDefault();
        const href = langToggle.getAttribute("href") || "";
        const hash = window.location.hash || "";

        const isEnglishTarget = href.startsWith("/en");
        localStorage.setItem("preferred-language", isEnglishTarget ? "en" : "es");

        window.location.href = href + hash;
      });
    }
  }

  document.addEventListener("astro:page-load", initAside);
</script>
