---
import { getCollection } from 'astro:content'
import { getTranslations } from "@/lib/i18n";

const { lang = "es" } = Astro.props;
const t = getTranslations(lang);

const certifiesRaw = await getCollection('certifies')
const certifies = certifiesRaw
  .filter(item => item.id.startsWith(`${lang}/`))
  .map((item) => item.data)
---

<div class="space-y-12">
    <header class="max-w-2xl">
        <p class="text-base md:text-lg text-muted-foreground leading-relaxed font-normal">
            {t.certifies.headerPrefix}<span class="cert-highlight font-black tracking-tight uppercase">{t.certifies.headerHighlight}</span>{t.certifies.headerSuffix}
        </p>
    </header>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {certifies.map((certifie, i) => (
            <a
                href={certifie.pdf}
                target="_blank"
                rel="noopener noreferrer"
                class="cert-card group relative flex flex-col p-7 rounded-2xl border overflow-hidden transition-[transform,box-shadow,border-color] duration-200 active:scale-[0.98] hover:-translate-y-0.5 hover:shadow-lg"
            >

                <!-- Número -->
                <span class="cert-number block text-[10px] font-black uppercase tracking-[0.3em] mb-6 select-none transition-colors duration-200">
                  {String(i + 1).padStart(2, "0")}
                </span>

                <!-- Icono de certificado -->
                <div class="cert-icon mb-6 size-10 flex items-center justify-center rounded-lg border border-border transition-colors duration-200 group-hover:border-amber-500/40">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="cert-icon-svg transition-colors duration-200">
                      <path d="m15.477 12.89 1.515 8.526a.5.5 0 0 1-.81.47l-3.58-2.687a1 1 0 0 0-1.197 0l-3.586 2.686a.5.5 0 0 1-.81-.469l1.514-8.526"/>
                      <circle cx="12" cy="8" r="6"/>
                    </svg>
                </div>

                <div class="flex-grow space-y-2 mb-8">
                    <h3 class="cert-title text-[17px] font-extrabold text-foreground tracking-tight leading-snug font-syne transition-colors duration-200">
                        {certifie.title}
                    </h3>
                    <p class="text-[13px] text-muted-foreground leading-relaxed font-normal">
                        {certifie.description}
                    </p>
                </div>

                <div class="flex items-center gap-1.5 cert-cta transition-[color,transform] duration-200">
                    <span class="text-[10px] font-black uppercase tracking-[0.25em]">{t.certifies.view}</span>
                    <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-200 group-hover:translate-x-1">
                      <path d="M5 12h14"/>
                      <path d="m12 5 7 7-7 7"/>
                    </svg>
                </div>
            </a>
        ))}
    </div>
</div>

<style>
  /* Highlight del header */
  .cert-highlight {
    color: oklch(0.65 0.18 40);
  }
  :global(.dark) .cert-highlight {
    color: oklch(0.72 0.17 44);
  }

  /* Card base */
  .cert-card {
    background: var(--card);
    border-color: var(--border);
  }
  :global(.dark) .cert-card {
    background: var(--card);
    border-color: var(--border);
  }
  .cert-card:hover {
    border-color: oklch(0.65 0.18 40 / 0.4);
    box-shadow: 0 8px 28px oklch(0.65 0.18 40 / 0.08);
  }
  :global(.dark) .cert-card:hover {
    border-color: oklch(0.72 0.17 44 / 0.45);
    box-shadow: 0 8px 28px oklch(0.65 0.18 40 / 0.14);
  }

  /* Número */
  .cert-number {
    color: var(--muted-foreground);
    opacity: 0.7;
  }
  :global(.dark) .cert-number {
    color: var(--muted-foreground);
    opacity: 0.7;
  }
  .cert-card:hover .cert-number {
    color: oklch(0.65 0.18 40);
    opacity: 1;
  }
  :global(.dark) .cert-card:hover .cert-number {
    color: oklch(0.72 0.17 44);
    opacity: 1;
  }

  /* Icono */
  .cert-icon {
    background: var(--muted);
    color: var(--muted-foreground);
  }
  :global(.dark) .cert-icon {
    background: oklch(0.16 0.014 38);
    color: var(--muted-foreground);
  }
  .cert-card:hover .cert-icon-svg {
    color: oklch(0.65 0.18 40);
  }
  :global(.dark) .cert-card:hover .cert-icon-svg {
    color: oklch(0.72 0.17 44);
  }
  .cert-card:hover .cert-icon {
    background: var(--card);
  }
  :global(.dark) .cert-card:hover .cert-icon {
    background: oklch(0.18 0.016 38);
  }

  /* Título hover */
  .cert-card:hover .cert-title {
    color: oklch(0.55 0.16 36);
  }
  :global(.dark) .cert-card:hover .cert-title {
    color: oklch(0.72 0.17 44);
  }

  /* CTA arrow */
  .cert-cta {
    color: var(--muted-foreground);
  }
  :global(.dark) .cert-cta {
    color: var(--muted-foreground);
  }
  .cert-card:hover .cert-cta {
    color: oklch(0.65 0.18 40);
  }
  :global(.dark) .cert-card:hover .cert-cta {
    color: oklch(0.72 0.17 44);
  }
</style>
