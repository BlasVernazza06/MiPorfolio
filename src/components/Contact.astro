---
import { Mail, Copy, CheckCircle2 } from "lucide-react";
import { getTranslations } from "@/lib/i18n";

const { lang = "es" } = Astro.props;
const t = getTranslations(lang);

const emailAddress = import.meta.env.EMAIL_ADDRESS || "blasvernazza123@gmail.com";
---

<div class="contact-wrapper relative w-full rounded-2xl overflow-hidden border border-border p-10 md:p-16">
  <!-- Fondo oscuro cálido -->
  <div class="absolute inset-0 -z-0" style="background: oklch(0.13 0.015 38);"></div>

  <!-- Orbe naranja sutil -->
  <div class="absolute -top-20 -right-20 w-80 h-80 rounded-full pointer-events-none" style="background: radial-gradient(circle, oklch(0.65 0.18 40 / 0.15) 0%, transparent 65%); filter: blur(40px);"></div>
  <div class="absolute -bottom-20 -left-20 w-72 h-72 rounded-full pointer-events-none" style="background: radial-gradient(circle, oklch(0.55 0.16 36 / 0.10) 0%, transparent 65%); filter: blur(50px);"></div>

  <div class="relative z-10 flex flex-col items-center justify-center gap-8 text-center">
    <div class="space-y-5 max-w-2xl">
      <h2 class="text-4xl md:text-5xl font-extrabold tracking-tight leading-tight" style="color: oklch(0.97 0.006 52); font-family: 'Syne', sans-serif;">
        {t.contact.titlePrefix} <br class="hidden sm:block" />
        <span class="contact-highlight italic font-medium">{t.contact.titleHighlight}</span>
      </h2>
      <p class="text-base md:text-lg leading-relaxed font-normal" style="color: oklch(0.62 0.018 48);">
        {t.contact.desc}
      </p>
    </div>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 w-full pt-2">
      <a
        href={`mailto:${emailAddress}`}
        class="contact-btn-primary inline-flex items-center justify-center gap-2 px-8 py-4 font-bold uppercase tracking-[0.15em] text-[12px] rounded-lg transition-all duration-300 hover:-translate-y-0.5 hover:shadow-xl active:translate-y-0 whitespace-nowrap w-full sm:w-auto"
      >
        <Mail className="size-4" />
        {t.contact.send}
      </a>

      <button
        id="copy-email-btn"
        data-email={emailAddress}
        class="contact-btn-secondary group inline-flex items-center justify-center gap-2 px-8 py-4 font-bold uppercase tracking-[0.15em] text-[12px] rounded-lg transition-all duration-300 hover:-translate-y-0.5 active:translate-y-0 whitespace-nowrap w-full sm:w-auto"
      >
        <span class="relative flex items-center justify-center size-4">
          <Copy className="copy-icon size-4 absolute transition-all duration-300" />
          <CheckCircle2 className="check-icon size-4 absolute transition-all duration-300 scale-0 opacity-0" style={{color: "oklch(0.72 0.17 44)"}} />
        </span>
        <span
          id="copy-text"
          class="copy-text transition-colors duration-300"
          data-copied-text={t.contact.copied}
        >{t.contact.copy}</span>
      </button>
    </div>
  </div>
</div>

<style>
  .contact-highlight {
    color: oklch(0.72 0.17 44);
  }

  .contact-btn-primary {
    background: oklch(0.72 0.17 44);
    color: oklch(0.10 0.012 38);
    box-shadow: 0 4px 20px oklch(0.65 0.18 40 / 0.25);
  }
  .contact-btn-primary:hover {
    background: oklch(0.64 0.17 42);
    box-shadow: 0 8px 30px oklch(0.65 0.18 40 / 0.35);
  }

  .contact-btn-secondary {
    background: oklch(0.20 0.018 38);
    color: oklch(0.75 0.012 52);
    border: 1px solid oklch(0.28 0.020 38);
  }
  .contact-btn-secondary:hover {
    background: oklch(0.24 0.018 38);
    border-color: oklch(0.72 0.17 44 / 0.35);
    color: oklch(0.90 0.008 52);
  }
</style>

<script>
  function initContactCopy() {
    const copyBtn = document.getElementById("copy-email-btn");
    const copyText = document.getElementById("copy-text");

    if (copyBtn && copyText) {
      copyBtn.addEventListener("click", async () => {
        try {
          const emailToCopy = copyBtn.getAttribute("data-email") || "";
          await navigator.clipboard.writeText(emailToCopy);
          const originalText = copyText.innerText;
          const copiedText = copyText.getAttribute("data-copied-text") || "¡Copiado!";
          const copyIcon = copyBtn.querySelector(".copy-icon");
          const checkIcon = copyBtn.querySelector(".check-icon");

          copyText.innerText = copiedText;
          copyText.style.color = "oklch(0.72 0.17 44)";
          if (copyIcon) { copyIcon.style.opacity = "0"; copyIcon.style.transform = "scale(0)"; }
          if (checkIcon) { checkIcon.style.opacity = "1"; checkIcon.style.transform = "scale(1)"; }

          setTimeout(() => {
            copyText.innerText = originalText;
            copyText.style.color = "";
            if (copyIcon) { copyIcon.style.opacity = "1"; copyIcon.style.transform = "scale(1)"; }
            if (checkIcon) { checkIcon.style.opacity = "0"; checkIcon.style.transform = "scale(0)"; }
          }, 2000);
        } catch (err) {
          console.error("Failed to copy email: ", err);
        }
      });
    }
  }

  document.addEventListener("astro:page-load", initContactCopy);
</script>
