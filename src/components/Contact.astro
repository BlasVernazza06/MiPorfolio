---
import { Mail, Copy, CheckCircle2 } from "lucide-react";
import { getTranslations } from "@/lib/i18n";

const { lang = "es" } = Astro.props;
const t = getTranslations(lang);

const emailAddress = import.meta.env.EMAIL_ADDRESS || "blasvernazza123@gmail.com";
---

<div
  class="relative w-full rounded-[2.5rem] bg-zinc-900/80 backdrop-blur-md overflow-hidden border border-zinc-800 p-10 md:p-16 shadow-2xl"
>
  <!-- Glow Effect -->
  <div
    class="absolute -top-24 -right-24 w-96 h-96 bg-emerald-500/20 rounded-full blur-[100px] pointer-events-none"
  >
  </div>
  <div
    class="absolute -bottom-24 -left-24 w-96 h-96 bg-emerald-500/10 rounded-full blur-[100px] pointer-events-none"
  >
  </div>

  <div
    class="relative z-10 flex flex-col items-center justify-center gap-8 text-center"
  >
    <div class="space-y-6 max-w-2xl">
      <h2 class="text-5xl md:text-6xl font-black tracking-tighter text-white">
        {t.contact.titlePrefix} <br class="hidden sm:block" />
        <span class="text-emerald-500 italic font-medium serif"
          >{t.contact.titleHighlight}</span
        >
      </h2>
      <p class="text-lg md:text-xl text-zinc-400 leading-relaxed font-medium">
        {t.contact.desc}
      </p>
    </div>

    <div
      class="flex flex-col sm:flex-row items-center justify-center gap-4 w-full pt-4"
    >
      <a
        href={`mailto:${emailAddress}`}
        class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-emerald-500 text-zinc-950 font-black uppercase tracking-widest rounded-2xl hover:bg-emerald-400 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-emerald-500/20 active:translate-y-0 whitespace-nowrap w-full sm:w-auto"
      >
        <Mail className="size-5" />
        {t.contact.send}
      </a>

      <button
        id="copy-email-btn"
        data-email={emailAddress}
        class="group inline-flex items-center justify-center gap-2 px-8 py-4 bg-zinc-800/50 text-zinc-100 font-black uppercase tracking-widest rounded-2xl border border-zinc-700 hover:bg-zinc-700 hover:border-zinc-600 transition-all duration-300 hover:-translate-y-1 active:translate-y-0 whitespace-nowrap w-full sm:w-auto"
      >
        <span class="relative flex items-center justify-center size-5">
          <Copy
            className="size-5 absolute transition-all duration-300 scale-100 opacity-100 group-[.copied]:scale-0 group-[.copied]:opacity-0"
          />
          <CheckCircle2
            className="size-5 absolute transition-all duration-300 scale-0 opacity-0 text-emerald-500 group-[.copied]:scale-100 group-[.copied]:opacity-100"
          />
        </span>
        <span
          id="copy-text"
          class="transition-colors duration-300 group-[.copied]:text-emerald-500"
          data-copied-text={t.contact.copied}
          >{t.contact.copy}</span
        >
      </button>
    </div>
  </div>
</div>

<script>
  function initContactCopy() {
    const copyBtn = document.getElementById("copy-email-btn");
    const copyText = document.getElementById("copy-text");

    if (copyBtn && copyText) {
      copyBtn.addEventListener("click", async () => {
        try {
          const emailToCopy = copyBtn.getAttribute("data-email") || "";
          await navigator.clipboard.writeText(emailToCopy);
          const originalText = copyText.innerText;
          const copiedText = copyText.getAttribute("data-copied-text") || "¡Copiado!";

          copyText.innerText = copiedText;
          copyBtn.classList.add("copied");

          setTimeout(() => {
            copyText.innerText = originalText;
            copyBtn.classList.remove("copied");
          }, 2000);
        } catch (err) {
          console.error("Failed to copy email: ", err);
        }
      });
    }
  }

  // Support View Transitions
  document.addEventListener("astro:page-load", initContactCopy);
</script>
