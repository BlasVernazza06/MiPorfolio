---
import { getCollection } from "astro:content";
import TechStackCards from "./TechStackCarousel";
import { getTranslations } from "@/lib/i18n";

const { lang = "es" } = Astro.props;
const t = getTranslations(lang);

const skillsRaw = await getCollection("techStack");

const ORDER = ["Frontend", "Backend", "Herramientas", "Aprendiendo"];

const skills = skillsRaw
  .sort((a, b) => ORDER.indexOf(a.data.title) - ORDER.indexOf(b.data.title))
  .map((item) => ({
    ...item.data,
    title: t.skills.categories[item.data.title] || item.data.title
  }));
---

<div class="space-y-12">
  <header class="max-w-4xl">
    <p
      class="text-base md:text-lg text-zinc-500 dark:text-zinc-400 leading-relaxed font-medium"
    >
      {t.skills.headerPrefix}<span
        class="text-emerald-500 font-black tracking-tighter uppercase italic"
        >{t.skills.headerHighlight}</span
      >{t.skills.headerSuffix}
    </p>
  </header>

  <TechStackCards skills={skills} client:load />
</div>
