---
import { getTranslations } from "@/lib/i18n";

const { lang = "es" } = Astro.props;
const t = getTranslations(lang);

const experiences = [
  {
    date: t.experience.freelanceDate,
    title: t.experience.freelanceTitle,
    company: t.experience.freelanceCompany,
    description: t.experience.freelanceDesc,
    link: "https://www.fiverr.com/blas_vernazza",
    technologies: ["Next.js", "React Native", "Node.js", "PostgreSQL"]
  },
  {
    date: t.experience.hmiDate,
    title: t.experience.hmiTitle,
    company: t.experience.hmiCompany,
    description: t.experience.hmiDesc,
    technologies: ["Node-red", "Node.js", "JSON", "HTML", "CSS", "JavaScript"]
  }
];
---

<div class="relative space-y-16">
  <!-- Dynamic Timeline Line -->
  <div class="absolute left-0 md:left-1/2 top-0 bottom-0 w-px bg-gradient-to-b from-emerald-500 via-zinc-200 dark:via-zinc-800 to-transparent -translate-x-1/2 hidden md:block opacity-50"></div>

  {experiences.map((exp, index) => (
    <div class={`relative flex flex-col md:flex-row items-center gap-12 ${index % 2 === 0 ? 'md:flex-row' : 'md:flex-row-reverse'}`}>
      <!-- Bullet Terminal Style -->
      <div class="absolute left-0 md:left-1/2 w-3 h-3 rounded-full bg-emerald-500 z-10 -translate-x-1/2 hidden md:block shadow-[0_0_15px_rgba(16,185,129,0.4)] border-4 border-white dark:border-zinc-950"></div>

      <!-- Card Container -->
      <div class="w-full md:w-[45%] group animate-fade-in-up" style={`animation-delay: ${index * 0.2}s`}>
        <div class="p-10 rounded-[2.5rem] bg-white/40 dark:bg-zinc-900/40 backdrop-blur-md border border-zinc-200/50 dark:border-zinc-800/50 transition-all duration-700 hover:-translate-y-2 hover:shadow-2xl hover:shadow-emerald-500/5 relative overflow-hidden group/card">
          
          <!-- Corner Accent -->
          <div class="absolute top-0 right-0 size-16 bg-gradient-to-bl from-emerald-500/10 to-transparent opacity-0 group-hover/card:opacity-100 transition-opacity duration-700"></div>
          
          <header class="mb-6">
            <time class="text-[10px] font-black uppercase tracking-[0.3em] text-emerald-600 dark:text-emerald-400 mb-3 block">
              {exp.date}
            </time>
            <h3 class="text-3xl font-black text-zinc-900 dark:text-zinc-50 tracking-tighter mb-1 leading-none">
              {exp.title}
            </h3>
            <p class="text-sm font-bold text-zinc-400 dark:text-zinc-500 italic">
              @ {exp.company}
            </p>
          </header>
          
          <p class="text-[15px] text-zinc-600 dark:text-zinc-400 leading-relaxed mb-8 font-medium">
            {exp.description}
          </p>

          <footer class="flex flex-wrap gap-2 pt-6 border-t border-zinc-100/50 dark:border-zinc-800/50">
            {exp.technologies.map(tech => (
              <span class="px-3 py-1.5 rounded-lg bg-zinc-100 dark:bg-zinc-800 text-zinc-500 dark:text-zinc-400 text-[10px] font-black uppercase tracking-widest border border-transparent dark:border-zinc-700/50 hover:border-emerald-500/30 transition-colors">
                {tech}
              </span>
            ))}
          </footer>
        </div>
      </div>

      <!-- Empty spacer for symmetric feel -->
      <div class="hidden md:block w-[45%]"></div>
    </div>
  ))}
</div>

<style>
  @keyframes fade-in-up {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .animate-fade-in-up {
    animation: fade-in-up 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
</style>
