---
import { getTranslations } from "@/lib/i18n";

const { lang = "es" } = Astro.props;
const t = getTranslations(lang);

const experiences = [
  {
    date: t.experience.freelanceDate,
    title: t.experience.freelanceTitle,
    company: t.experience.freelanceCompany,
    description: t.experience.freelanceDesc,
    link: "https://www.fiverr.com/blas_vernazza",
    technologies: ["Next.js", "React Native", "Node.js", "PostgreSQL"],
    index: "01",
  },
  {
    date: t.experience.hmiDate,
    title: t.experience.hmiTitle,
    company: t.experience.hmiCompany,
    description: t.experience.hmiDesc,
    technologies: ["Node-red", "Node.js", "JSON", "HTML", "CSS", "JavaScript"],
    index: "02",
  },
];
---

<div class="flex flex-col gap-6">
  {experiences.map((exp) => (
    <div class="exp-card relative grid grid-cols-1 md:grid-cols-[160px_1fr] overflow-hidden rounded-2xl border transition-all duration-300 group">



      <!-- Columna izquierda: índice + fecha -->
      <div class="exp-left flex md:flex-col items-start md:items-start gap-3 p-6 md:p-8 border-b md:border-b-0 md:border-r border-current/10">
        <div class="exp-index text-[11px] font-black uppercase tracking-[0.3em] select-none opacity-40">
          {exp.index}
        </div>
        <time class="exp-date text-[11px] font-black uppercase tracking-[0.2em] leading-tight block">
          {exp.date}
        </time>
      </div>

      <!-- Columna derecha: contenido -->
      <div class="p-6 md:p-8">
        <header class="mb-4">
          <h3 class="exp-title text-2xl md:text-3xl font-extrabold tracking-tight leading-tight mb-1.5 transition-colors duration-300" style="font-family: 'Syne', sans-serif;">
            {exp.title}
          </h3>
          <p class="text-sm font-medium italic opacity-60">
            {exp.company}
          </p>
        </header>

        <p class="text-[15px] leading-relaxed mb-6 opacity-70 font-normal max-w-xl">
          {exp.description}
        </p>

        <!-- Pills -->
        <div class="flex flex-wrap gap-2 mb-4">
          {exp.technologies.map((tech) => (
            <span class="exp-pill px-2.5 py-1 rounded-md text-[10px] font-black uppercase tracking-widest border transition-colors duration-200">
              {tech}
            </span>
          ))}
        </div>

        {exp.link && (
          <a
            href={exp.link}
            target="_blank"
            rel="noopener noreferrer"
            class="exp-link inline-flex items-center gap-1.5 text-[11px] font-black uppercase tracking-[0.2em] transition-all duration-200 hover:gap-2.5"
          >
            <span>Fiverr Profile</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg>
          </a>
        )}
      </div>
    </div>
  ))}
</div>

<style>
  /* ── LIGHT MODE ── */
  .exp-card {
    background: oklch(1 0.003 58);
    border-color: oklch(0.88 0.025 52);
    color: oklch(0.14 0.018 42);
  }

  .exp-stripe {
    background: oklch(0.88 0.025 52);
  }

  .exp-left {
    background: oklch(0.97 0.010 56);
  }

  .exp-date {
    color: oklch(0.55 0.16 36);
  }

  .exp-title {
    color: oklch(0.14 0.018 42);
  }

  .exp-pill {
    background: oklch(0.94 0.020 55);
    color: oklch(0.40 0.06 40);
    border-color: oklch(0.86 0.030 52);
  }

  .exp-link {
    color: oklch(0.55 0.16 36);
  }
  .exp-link:hover {
    color: oklch(0.44 0.13 33);
  }

  /* hover card */
  .exp-card:hover {
    border-color: oklch(0.65 0.18 40 / 0.5);
    box-shadow: 0 8px 32px oklch(0.65 0.18 40 / 0.08);
  }
  .exp-card:hover .exp-stripe {
    background: oklch(0.65 0.18 40);
  }
  .exp-card:hover .exp-title {
    color: oklch(0.55 0.16 36);
  }
  .exp-card:hover .exp-pill {
    border-color: oklch(0.65 0.18 40 / 0.4);
    color: oklch(0.44 0.13 33);
  }

  /* ── DARK MODE ── */
  :global(.dark) .exp-card {
    background: oklch(0.14 0.014 38);
    border-color: oklch(0.22 0.020 38);
    color: oklch(0.95 0.008 52);
  }

  :global(.dark) .exp-stripe {
    background: oklch(0.22 0.020 38);
  }

  :global(.dark) .exp-left {
    background: oklch(0.12 0.012 38);
  }

  :global(.dark) .exp-date {
    color: oklch(0.72 0.17 44);
  }

  :global(.dark) .exp-title {
    color: oklch(0.95 0.008 52);
  }

  :global(.dark) .exp-pill {
    background: oklch(0.17 0.016 38);
    color: oklch(0.65 0.012 48);
    border-color: oklch(0.26 0.020 38);
  }

  :global(.dark) .exp-link {
    color: oklch(0.72 0.17 44);
  }
  :global(.dark) .exp-link:hover {
    color: oklch(0.80 0.16 46);
  }

  :global(.dark) .exp-card:hover {
    border-color: oklch(0.72 0.17 44 / 0.4);
    box-shadow: 0 8px 32px oklch(0.65 0.18 40 / 0.12);
  }
  :global(.dark) .exp-card:hover .exp-stripe {
    background: oklch(0.72 0.17 44);
  }
  :global(.dark) .exp-card:hover .exp-title {
    color: oklch(0.72 0.17 44);
  }
  :global(.dark) .exp-card:hover .exp-pill {
    border-color: oklch(0.72 0.17 44 / 0.3);
    color: oklch(0.72 0.17 44);
  }
</style>
