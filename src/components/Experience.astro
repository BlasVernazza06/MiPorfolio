---
const experiences = [
  {
    date: "Enero 2024 - Presente",
    title: "Full Stack Developer Freelance",
    company: "Proyectos Independientes",
    description: "Desarrollo de aplicaciones web y móviles personalizadas para clientes internacionales, enfocándome en arquitecturas escalables y diseño centrado en el usuario.",
    link: "https://www.fiverr.com/blas_vernazza",
    technologies: ["Next.js", "React Native", "Node.js", "PostgreSQL"]
  },
  {
    date: "2024",
    title: "Diseño de Interfaz para pasteurizadora",
    company: "IAR",
    description: "Diseño de Interfaz para pasteurizadora",
    technologies: ["Node-red", "Node.js", "JSON", "HTML", "CSS", "JavaScript"]
  }
];
---

<div class="relative space-y-12">
  <!-- Decorative Vertical Line -->
  <div class="absolute left-0 md:left-1/2 top-0 bottom-0 w-[2px] bg-gradient-to-b from-emerald-500 via-emerald-500/30 to-transparent -translate-x-1/2 hidden md:block opacity-70"></div>

  {experiences.map((exp, index) => (
    <div class={`relative flex flex-col md:flex-row items-center gap-8 ${index % 2 === 0 ? 'md:flex-row' : 'md:flex-row-reverse'}`}>
      <!-- Bullet -->
      <div class="absolute left-0 md:left-1/2 w-4 h-4 rounded-full bg-white dark:bg-zinc-900 border-2 border-emerald-500 z-10 -translate-x-1/2 hidden md:block shadow-[0_0_10px_rgba(16,185,129,0.5)]"></div>

      <!-- Content Card -->
      <div class="w-full md:w-[45%] group">
        <div class="p-8 rounded-[2rem] bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 transition-all duration-500 hover:-translate-y-2 hover:shadow-2xl hover:shadow-emerald-500/10 relative overflow-hidden">
          <!-- Glow effect -->
          <div class="absolute -top-24 -right-24 w-48 h-48 bg-emerald-500/5 rounded-full blur-3xl group-hover:bg-emerald-500/10 transition-colors"></div>
          
          <span class="text-xs font-bold text-emerald-600 dark:text-emerald-400 uppercase tracking-[0.2em] mb-4 block">
            {exp.date}
          </span>
          
          <h3 class="text-2xl font-bold text-zinc-900 dark:text-zinc-50 font-outfit mb-1 group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors">
            {exp.title}
          </h3>
          
          <p class="text-sm font-semibold text-zinc-500 dark:text-zinc-500 mb-4 italic">
            {exp.company}
          </p>
          
          <p class="text-zinc-600 dark:text-zinc-400 leading-relaxed mb-6">
            {exp.description}
          </p>

          <div class="flex flex-wrap gap-2">
            {exp.technologies.map(tech => (
              <span class="px-3 py-1 rounded-lg bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-400 text-[10px] font-bold uppercase tracking-wider">
                {tech}
              </span>
            ))}
          </div>
        </div>
      </div>

      <!-- Spacer for desktop -->
      <div class="hidden md:block w-[45%]"></div>
    </div>
  ))}
</div>
