---
import { getTranslations } from "@/lib/i18n";

const { lang = "es" } = Astro.props;
const t = getTranslations(lang);
const prefix = lang === "en" ? "/en" : "";

const navItems = [
  { title: t.nav.inicio, label: "inicio", url: `${prefix}/#Inicio` },
  { title: t.nav.proyectos, label: "proyectos", url: `${prefix}/#Proyects` },
  { title: t.nav.experiencia, label: "experiencia", url: `${prefix}/#Experiencia` },
  { title: t.nav.skills, label: "skills", url: `${prefix}/#Skills` },
  { title: t.nav.sobreMi, label: "sobre-mi", url: `${prefix}/#Sobre-mi` },
  { title: t.nav.certificados, label: "certificados", url: `${prefix}/#Certificados` },
];
---

<header class="navbar-root fixed top-0 left-0 right-0 z-50 flex items-center justify-between px-6 md:px-10 h-14 transition-all duration-300">

  <!-- Logo / Marca -->
  <a href={`${prefix}/#Inicio`} class="navbar-logo flex items-center gap-2.5 shrink-0 group" aria-label="Ir al inicio">
    <!-- Punto naranja vivo -->
    <span class="navbar-dot size-2.5 rounded-full transition-all duration-300 group-hover:scale-125" style="background: oklch(0.72 0.17 44);"></span>
    <span class="text-xl md:text-2xl font-black uppercase tracking-[0.1em] text-foreground/90 group-hover:text-foreground transition-colors font-syne leading-none">
      BV
    </span>
  </a>

  <!-- Desktop nav — links como texto limpio -->
  <nav class="hidden md:flex items-center gap-0" aria-label="Navegación principal">
    {
      navItems.map((link) => (
        <a
          class="navbar-link relative px-4 py-4 text-[11px] font-bold text-muted-foreground uppercase tracking-[0.18em] transition-colors duration-200 hover:text-foreground"
          aria-label={link.label}
          href={link.url}
        >
          {link.title}
        </a>
      ))
    }
  </nav>

  <!-- Mobile: botón hamburguesa -->
  <button
    id="mobile-nav-toggle"
    aria-label="Abrir menú de navegación"
    class="md:hidden flex items-center justify-center size-9 rounded-md border border-border/50 bg-card/60 backdrop-blur-sm text-foreground hover:text-amber-500 hover:border-amber-500/30 active:scale-90 transition-all duration-200"
  >
    <svg id="icon-menu" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <line x1="4" x2="20" y1="8" y2="8"/>
      <line x1="4" x2="20" y1="16" y2="16"/>
    </svg>
    <svg id="icon-close" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="hidden">
      <path d="M18 6 6 18"/><path d="m6 6 12 12"/>
    </svg>
  </button>

  <!-- Mobile panel -->
  <div
    id="mobile-nav-panel"
    class="md:hidden absolute top-14 left-0 right-0 border-t border-border/40 bg-background/95 backdrop-blur-xl flex flex-col divide-y divide-border/30 translate-y-[-100%] opacity-0 pointer-events-none transition-all duration-300 origin-top"
  >
    {
      navItems.map((link) => (
        <a
          class="mobile-link px-6 py-4 text-[11px] font-bold text-muted-foreground uppercase tracking-[0.2em] hover:text-amber-600 dark:hover:text-amber-400 hover:bg-amber-500/4 transition-colors text-left"
          aria-label={link.label}
          href={link.url}
        >
          {link.title}
        </a>
      ))
    }
  </div>

</header>

<style>
  /* El navbar toma fondo al hacer scroll */
  .navbar-root {
    background: transparent;
    border-bottom: 1px solid transparent;
  }

  .navbar-root.scrolled {
    background: oklch(0.98 0.008 58 / 0.88);
    border-bottom-color: oklch(0.88 0.025 52 / 0.6);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }

  :global(.dark) .navbar-root.scrolled {
    background: oklch(0.10 0.012 38 / 0.92);
    border-bottom-color: oklch(0.22 0.020 38 / 0.6);
  }

  /* Línea naranja bajo el link activo / hover */
  .navbar-link::after {
    content: '';
    position: absolute;
    bottom: 8px;
    left: 1rem;
    right: 1rem;
    height: 1.5px;
    background: oklch(0.65 0.18 40);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .navbar-link:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  /* Mobile panel open state */
  #mobile-nav-panel.open {
    translate: 0;
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }
</style>

<script>
  function initNavbar() {
    const root = document.querySelector(".navbar-root") as HTMLElement | null;
    const toggleBtn = document.getElementById("mobile-nav-toggle");
    const panel = document.getElementById("mobile-nav-panel");
    const iconMenu = document.getElementById("icon-menu");
    const iconClose = document.getElementById("icon-close");
    const links = document.querySelectorAll(".mobile-link");

    // Scroll detection
    if (root) {
      const onScroll = () => {
        root.classList.toggle("scrolled", window.scrollY > 30);
      };
      window.addEventListener("scroll", onScroll, { passive: true });
      onScroll();
    }

    // Toggle
    if (toggleBtn && panel && iconMenu && iconClose) {
      const open = () => {
        panel.classList.add("open");
        iconMenu.classList.add("hidden");
        iconClose.classList.remove("hidden");
      };
      const close = () => {
        panel.classList.remove("open");
        iconMenu.classList.remove("hidden");
        iconClose.classList.add("hidden");
      };

      toggleBtn.addEventListener("click", (e) => {
        e.stopPropagation();
        panel.classList.contains("open") ? close() : open();
      });

      document.addEventListener("click", (e) => {
        if (!panel.contains(e.target as Node) && e.target !== toggleBtn) close();
      });

      links.forEach((link) => link.addEventListener("click", close));
    }
  }

  document.addEventListener("astro:page-load", initNavbar);
</script>
