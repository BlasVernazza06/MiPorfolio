---
import { getTranslations } from "@/lib/i18n";

const { lang = "es" } = Astro.props;
const t = getTranslations(lang);
const prefix = lang === "en" ? "/en" : "";

const navItems = [
  { title: t.nav.inicio, label: "inicio", url: `${prefix}/#Inicio` },
  { title: t.nav.proyectos, label: "proyectos", url: `${prefix}/#Proyects` },
  { title: t.nav.experiencia, label: "experiencia", url: `${prefix}/#Experiencia` },
  { title: t.nav.skills, label: "skills", url: `${prefix}/#Skills` },
  { title: t.nav.sobreMi, label: "sobre-mi", url: `${prefix}/#Sobre-mi` },
  { title: t.nav.certificados, label: "certificados", url: `${prefix}/#Certificados` },
];
---

<header class="fixed top-6 z-50 flex items-center justify-center w-full px-4 group/nav">
  <nav class="flex items-center gap-1 p-1.5 rounded-2xl border border-transparent transition-all duration-500 hover:border-zinc-200/50 dark:hover:border-zinc-800/50">
    <div class="absolute inset-0 bg-white/20 dark:bg-zinc-900/20 backdrop-blur-md rounded-2xl shadow-sm -z-10 opacity-0 group-hover/nav:opacity-100 transition-opacity duration-300"></div>
    {
      navItems.map((link) => (
        <a
          class="px-4 py-2 text-[13px] font-bold text-zinc-500/80 dark:text-zinc-400/80 hover:text-emerald-600 dark:hover:text-white transition-all duration-300 rounded-xl hover:bg-emerald-500/5 dark:hover:bg-white/5 tracking-tight uppercase"
          aria-label={link.label}
          href={link.url}
        >
          {link.title}
        </a>
      ))
    }
  </nav>
</header>

<style>
  nav {
    animation: nav-reveal 0.5s linear both;
    animation-timeline: scroll();
    animation-range: 0 150px;
  }

  @keyframes nav-reveal {
    to {
      background-color: rgba(255, 255, 255, 0.6);
      border-color: rgba(228, 228, 231, 0.4);
      backdrop-filter: blur(12px);
      box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.05);
      padding-left: 0.75rem;
      padding-right: 0.75rem;
    }
  }

  :global(.dark) nav {
    animation: nav-reveal-dark 0.5s linear both;
    animation-timeline: scroll();
    animation-range: 0 150px;
  }

  @keyframes nav-reveal-dark {
    to {
      background-color: rgba(9, 9, 11, 0.7);
      border-color: rgba(63, 63, 70, 0.3);
      backdrop-filter: blur(12px);
      box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.4);
      padding-left: 0.75rem;
      padding-right: 0.75rem;
    }
  }

  @media (max-width: 640px) {
    nav {
      display: none;
    }
  }
</style>
