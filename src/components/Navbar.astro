---
const navItems = [
  {
    title: "Inicio",
    label: "inicio",
    url: "#Inicio",
  },
  {
    title: "Proyectos",
    label: "proyectos",
    url: "#Proyects",
  },
  {
    title: "Experiencia",
    label: "experiencia",
    url: "#Experiencia",
  },
  {
    title: "Skills",
    label: "skills",
    url: "#Skills",
  },
  {
    title: "Sobre mí",
    label: "sobre-mi",
    url: "#Sobre-mi",
  },
  {
    title: "Certificados",
    label: "certificados",
    url: "#Certificados",
  },
];
---

<header
  class="header fixed top-4 z-50 flex items-center justify-center w-full px-4"
>
  <nav
    class="flex items-center gap-1 p-1 rounded-2xl transition-all duration-300"
  >
    {
      navItems.map((link) => (
        <a
          class="px-4 py-2 text-sm font-semibold text-zinc-600 dark:text-zinc-400 hover:text-emerald-600 dark:hover:text-emerald-400 transition-all duration-300 rounded-xl hover:bg-emerald-500/5 dark:hover:bg-emerald-500/10 active:scale-95"
          aria-label={link.label}
          href={link.url}
        >
          {link.title}
        </a>
      ))
    }
  </nav>
</header>

<style>
  nav {
    animation: nav-reveal 1s linear both;
    animation-timeline: scroll();
    animation-range: 0 100px;
  }

  @keyframes nav-reveal {
    0% {
      background-color: rgba(255, 255, 255, 0);
      border-color: rgba(0, 0, 0, 0);
      backdrop-filter: blur(0px);
      box-shadow: 0 0 #0000;
    }
    to {
      background-color: rgba(255, 255, 255, 0.7);
      border: 1px solid rgba(228, 228, 231, 0.8); /* zinc-200 approximation */
      backdrop-filter: blur(20px);
      box-shadow:
        0 10px 15px -3px rgba(0, 0, 0, 0.1),
        0 4px 6px -4px rgba(0, 0, 0, 0.1);
    }
  }

  :global(.dark) nav {
    animation: nav-reveal-dark 1s linear both;
    animation-timeline: scroll();
    animation-range: 0 100px;
  }

  @keyframes nav-reveal-dark {
    0% {
      background-color: rgba(9, 9, 11, 0);
      border-color: rgba(255, 255, 255, 0);
      backdrop-filter: blur(0px);
      box-shadow: 0 0 #0000;
    }
    to {
      background-color: rgba(24, 24, 27, 0.7); /* zinc-900 approximation */
      border: 1px solid rgba(63, 63, 70, 0.5); /* zinc-800 approximation */
      backdrop-filter: blur(20px);
      box-shadow:
        0 20px 25px -5px rgba(0, 0, 0, 0.3),
        0 10px 10px -5px rgba(0, 0, 0, 0.3);
    }
  }
</style>
