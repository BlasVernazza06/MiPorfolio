---
import { File } from "lucide-react";
import Github3 from "./icons/github3.astro";
import SocialPill from "./SocialPill.astro";
import { getTranslations } from "@/lib/i18n";

const { lang = "es" } = Astro.props;
const t = getTranslations(lang);
const prefix = lang === "en" ? "/en" : "";
---

<div class="relative w-full py-16 md:py-24">
  <!-- Subtle Gradient Glow (Safe within container) -->
  <div
    class="absolute top-1/2 left-0 -translate-y-1/2 w-64 h-64 bg-emerald-500/10 dark:bg-emerald-500/5 rounded-full blur-[100px] pointer-events-none"
  >
  </div>

  <div
    class="relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-12 items-start"
  >
    <!-- Left Accent Line -->
    <div class="hidden lg:flex lg:col-span-1 h-full flex-col items-center">
      <div
        class="w-px h-32 bg-gradient-to-b from-transparent via-emerald-500/50 to-emerald-500 animate-slide-down"
      >
      </div>
      <span
        class="[writing-mode:vertical-lr] rotate-180 py-8 text-[10px] font-black uppercase tracking-[0.4em] text-zinc-400 dark:text-zinc-600"
      >
        Portfolio 2024
      </span>
    </div>

    <!-- Main Content Cluster -->
    <div class="lg:col-span-7 space-y-10">
      <header class="space-y-4">
        <div
          class="inline-flex items-center gap-2 px-0 py-1 text-emerald-600 dark:text-emerald-400 font-bold text-xs uppercase tracking-widest animate-fade-in-left"
        >
          <span class="size-1.5 rounded-full bg-current animate-pulse"></span>
          {t.start.openToWork}
        </div>

        <h1
          class="text-6xl md:text-8xl font-black text-zinc-900 dark:text-white leading-[0.9] tracking-tighter animate-fade-in-left uppercase"
          style="animation-delay: 0.1s"
        >
          {t.start.creating} <br />
          <span
            class="text-emerald-500 dark:text-emerald-400 italic font-medium serif normal-case"
            >{t.start.solutions}</span
          ><br />
          {t.start.digital}
        </h1>
      </header>

      <p
        class="text-xl md:text-2xl text-zinc-600 dark:text-zinc-400 max-w-2xl leading-relaxed animate-fade-in-left font-medium"
        style="animation-delay: 0.2s"
      >
        {t.start.intro}
      </p>

      <footer
        class="flex flex-wrap gap-4 pt-4 animate-fade-in-left"
        style="animation-delay: 0.3s"
      >
        <SocialPill
          href="/files/Curriculum Vitae.pdf"
          class="flex items-center gap-2 px-8 py-4 bg-zinc-900 dark:bg-zinc-100 text-white dark:text-zinc-900 rounded-full font-black text-sm uppercase tracking-widest hover:bg-emerald-600 dark:hover:bg-emerald-400 transition-all shadow-xl shadow-emerald-500/10"
        >
          <File className="size-5" />
          {t.start.cv}
        </SocialPill>
        <SocialPill
          href={`${prefix}/#Proyects`}
          class="px-8 py-4 bg-transparent border-2 border-zinc-200 dark:border-zinc-800 text-zinc-900 dark:text-white rounded-full font-black text-sm uppercase tracking-widest hover:border-emerald-500 dark:hover:border-emerald-400 transition-all flex items-center gap-2"
        >
          <Github3 class="size-5" />
          {t.start.projects}
        </SocialPill>
      </footer>
    </div>

    <!-- Right Side Pillars (Desktop Only) -->
    <div class="lg:col-span-4 flex flex-col gap-12 pt-4">
      <div
        class="space-y-2 group animate-fade-in-right"
        style="animation-delay: 0.4s"
      >
        <h3
          class="text-zinc-400 dark:text-zinc-600 font-black text-[10px] uppercase tracking-widest group-hover:text-emerald-500 transition-colors"
        >
          {t.start.role1}
        </h3>
        <p class="text-sm text-zinc-500 dark:text-zinc-400 font-medium">
          {t.start.role1Desc}
        </p>
      </div>
      <div
        class="space-y-2 group animate-fade-in-right"
        style="animation-delay: 0.5s"
      >
        <h3
          class="text-zinc-400 dark:text-zinc-600 font-black text-[10px] uppercase tracking-widest group-hover:text-emerald-500 transition-colors"
        >
          {t.start.role2}
        </h3>
        <p class="text-sm text-zinc-500 dark:text-zinc-400 font-medium">
          {t.start.role2Desc}
        </p>
      </div>
      <div
        class="space-y-2 group animate-fade-in-right"
        style="animation-delay: 0.6s"
      >
        <h3
          class="text-zinc-400 dark:text-zinc-600 font-black text-[10px] uppercase tracking-widest group-hover:text-emerald-500 transition-colors"
        >
          {t.start.role3}
        </h3>
        <p class="text-sm text-zinc-500 dark:text-zinc-400 font-medium">
          {t.start.role3Desc}
        </p>
      </div>
    </div>
  </div>
</div>

<style>
  @keyframes slide-down {
    from {
      transform: translateY(-100%);
      opacity: 0;
    }
    to {
      transform: translateY(0);
      opacity: 1;
    }
  }
  @keyframes fade-in-left {
    from {
      opacity: 0;
      transform: translateX(-30px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }
  @keyframes fade-in-right {
    from {
      opacity: 0;
      transform: translateX(30px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  .animate-slide-down {
    animation: slide-down 1s ease-out forwards;
  }
  .animate-fade-in-left {
    animation: fade-in-left 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  .animate-fade-in-right {
    animation: fade-in-right 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
</style>
