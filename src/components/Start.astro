---
import { File } from "lucide-react";
import Github3 from "./icons/github3.astro";
import SocialPill from "./SocialPill.astro";
import { getTranslations } from "@/lib/i18n";

const { lang = "es" } = Astro.props;
const t = getTranslations(lang);
const prefix = lang === "en" ? "/en" : "";
---

<!--
  CONCEPT: Grid Editorial / Plano de Diseño
  Reemplazamos el layout tradicional por una grilla estructurada de líneas finas 
  que compartimenta la información como una revista de arquitectura o software de diseño de lujo.
  Bordajes rectos y limpios con radios de esquina muy reducidos (rounded-xl exterior, rounded-lg interior).
-->
<div class="editorial-grid w-full rounded-xl overflow-hidden border border-border/50 transition-all duration-500">

  <!-- Fila 1: Barra de Estado & Título de Rol -->
  <div class="grid grid-cols-1 lg:grid-cols-12 border-b border-border/50">
    <!-- Estado disponible -->
    <div class="lg:col-span-8 p-6 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <span class="relative flex size-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full opacity-60" style="background: oklch(0.72 0.17 44);"></span>
          <span class="relative inline-flex rounded-full size-2" style="background: oklch(0.72 0.17 44);"></span>
        </span>
        <span class="text-[10px] font-black uppercase tracking-[0.25em] text-muted-foreground">
          {t.start.openToWork}
        </span>
      </div>
    </div>
    
    <!-- Etiqueta de Rol derecha -->
    <div class="lg:col-span-4 p-6 border-t lg:border-t-0 lg:border-l border-border/50 flex items-center">
      <span class="text-[10px] font-black uppercase tracking-[0.25em] text-amber-600 dark:text-amber-400">
        {t.start.studio}
      </span>
    </div>
  </div>

  <!-- Fila 2: Nombre Monumental & Pilares -->
  <div class="grid grid-cols-1 lg:grid-cols-12 border-b border-border/50">
    <!-- Columna Nombre -->
    <div class="lg:col-span-8 p-6 md:p-10 flex flex-col justify-center relative overflow-hidden bg-gradient-to-br from-amber-500/[0.02] to-transparent">
      
      <!-- Orbe naranja sutil de fondo -->
      <div class="absolute -top-1/4 -right-1/4 size-[400px] pointer-events-none select-none -z-0" aria-hidden="true">
        <div class="absolute inset-0 rounded-full animate-ember-pulse" style="background: radial-gradient(circle, oklch(0.72 0.17 44 / 0.08) 0%, transparent 70%);"></div>
      </div>

      <h1 class="hero-name font-syne font-extrabold text-foreground leading-[0.88] tracking-[-0.04em] z-10">
        Blas<br/>
        <span class="hero-name-accent">Vernazza</span>
      </h1>
    </div>

    <!-- Columna Pilares (Foco de especialidad) -->
    <div class="lg:col-span-4 border-t lg:border-t-0 lg:border-l border-border/50 divide-y divide-border/50 flex flex-col justify-stretch">
      {[
        { label: t.start.role1, desc: t.start.role1Desc },
        { label: t.start.role2, desc: t.start.role2Desc },
        { label: t.start.role3, desc: t.start.role3Desc },
      ].map((item, index) => (
        <div class="p-6 flex-1 flex flex-col justify-center group hover:bg-amber-500/[0.02] transition-colors duration-300">
          <div class="flex items-center justify-between mb-2">
            <span class="text-[10px] font-mono text-muted-foreground/40 group-hover:text-amber-500/70 transition-colors duration-300">0{index + 1}</span>
            <span class="text-[10px] font-black uppercase tracking-[0.2em] text-amber-600 dark:text-amber-400">{item.label}</span>
          </div>
          <p class="text-[12px] text-muted-foreground leading-relaxed font-normal">{item.desc}</p>
        </div>
      ))}
    </div>
  </div>

  <!-- Fila 3: Descripción & Acciones -->
  <div class="grid grid-cols-1 lg:grid-cols-12">
    <!-- Intro text -->
    <div class="lg:col-span-8 p-6 md:p-8 flex items-center">
      <p class="text-base md:text-lg text-muted-foreground leading-relaxed font-normal max-w-2xl">
        {t.start.intro}
      </p>
    </div>

    <!-- Botones de Acción -->
    <div class="lg:col-span-4 p-6 border-t lg:border-t-0 lg:border-l border-border/50 flex flex-col sm:flex-row lg:flex-col gap-3 justify-center">
      <SocialPill
        href="/files/Curriculum Vitae.pdf"
        class="cta-grid-primary group flex items-center justify-center gap-2.5 py-3.5 px-6 font-bold text-[11px] uppercase tracking-[0.2em] transition-all duration-300 rounded-lg active:scale-95"
      >
        <File className="size-4" />
        <span>{t.start.cv}</span>
      </SocialPill>
      <SocialPill
        href={`${prefix}/#Proyects`}
        class="cta-grid-secondary flex items-center justify-center gap-2.5 py-3.5 px-6 font-bold text-[11px] uppercase tracking-[0.2em] transition-all duration-300 rounded-lg active:scale-95"
      >
        <Github3 class="size-4" />
        <span>{t.start.projects}</span>
      </SocialPill>
    </div>
  </div>

</div>

<style>
  /* ── GRID ESTILOS BASE ── */
  .editorial-grid {
    background: oklch(1 0.003 58 / 0.5);
  }
  :global(.dark) .editorial-grid {
    background: oklch(0.14 0.014 38 / 0.2);
  }

  /* Tamaño del nombre adaptable */
  .hero-name {
    font-size: clamp(2.2rem, 5.5vw, 4.2rem);
    letter-spacing: -0.05em;
  }

  .hero-name-accent {
    color: oklch(0.65 0.18 40);
  }
  :global(.dark) .hero-name-accent {
    color: oklch(0.72 0.17 44);
  }

  /* CTA Primario (Estructura de grilla sólida) */
  .cta-grid-primary {
    background: oklch(0.72 0.17 44);
    color: oklch(0.10 0.012 38);
    border: 1px solid transparent;
  }
  :global(.dark) .cta-grid-primary {
    background: oklch(0.72 0.17 44);
    color: oklch(0.10 0.012 38);
  }
  .cta-grid-primary:hover {
    background: oklch(0.64 0.17 42);
    color: oklch(0.10 0.012 38);
  }
  :global(.dark) .cta-grid-primary:hover {
    background: oklch(0.64 0.17 42);
  }

  /* CTA Secundario (Contorno fino) */
  .cta-grid-secondary {
    background: transparent;
    color: oklch(0.50 0.025 42);
    border: 1px solid oklch(0.85 0.025 52);
  }
  :global(.dark) .cta-grid-secondary {
    color: oklch(0.75 0.012 52);
    border-color: oklch(0.24 0.020 38);
  }
  .cta-grid-secondary:hover {
    border-color: oklch(0.65 0.18 40);
    color: oklch(0.55 0.16 36);
    background: oklch(0.65 0.18 40 / 0.04);
  }
  :global(.dark) .cta-grid-secondary:hover {
    border-color: oklch(0.72 0.17 44);
    color: oklch(0.72 0.17 44);
    background: oklch(0.72 0.17 44 / 0.04);
  }

  @keyframes ember-pulse {
    0%, 100% { transform: scale(1); opacity: 0.9; }
    50%       { transform: scale(1.1) translate(5px, -5px); opacity: 0.7; }
  }
  .animate-ember-pulse {
    animation: ember-pulse 8s ease-in-out infinite;
  }
</style>
