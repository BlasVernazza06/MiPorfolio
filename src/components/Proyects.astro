---
import { getCollection } from "astro:content";
import Github3 from "./icons/github3.astro";
import Demo from "./icons/Demo.astro";
import { getTranslations } from "@/lib/i18n";

const { lang = "es" } = Astro.props;
const t = getTranslations(lang);
const prefix = lang === "en" ? "/en" : "";

const proyectsRaw = await getCollection("proyects");
const proyectsVisible = proyectsRaw.filter(
  (item) => item.data.visible !== false && item.id.startsWith(`${lang}/`),
);
proyectsVisible.sort((a, b) => a.data.order - b.data.order);
const proyects = proyectsVisible.map((item) => ({
  ...item.data,
  id: item.id.replace(`${lang}/`, ""),
}));
---

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6" id="project-grid">
  {
    proyects.map((proyecto, i) => (
      <article class="project-card group relative flex flex-col rounded-2xl border overflow-hidden transition-[transform,box-shadow,border-color] duration-300 hover:-translate-y-1 hover:shadow-xl">

        <!-- Número de proyecto — placa editorial -->
        <div class="project-index absolute top-5 left-5 z-20 font-mono text-[11px] font-bold tracking-[0.25em] text-muted-foreground/60 group-hover:text-amber-500 transition-colors duration-200 select-none">
          {String(i + 1).padStart(2, "0")}
        </div>

        <!-- Imagen con proporción fija -->
        <a
          href={`${prefix}/proyects/${proyecto.id}`}
          class="block relative overflow-hidden"
          style="aspect-ratio: 16/9;"
          tabindex="0"
        >
          <img
            src={proyecto.imgInicio}
            alt={proyecto.title}
            class="w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.04]"
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
          <!-- Overlay que desaparece en hover -->
          <div class="absolute inset-0 bg-foreground/10 dark:bg-foreground/20 group-hover:opacity-0 transition-opacity duration-300"></div>

          {proyecto.liveNow && (
            <div class="absolute top-4 right-4 z-10 flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-background/80 backdrop-blur-sm border border-border text-foreground text-[9px] font-black uppercase tracking-[0.2em]">
              <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse" />
              {t.projectDetail.live}
            </div>
          )}
        </a>

        <!-- Contenido inferior -->
        <div class="flex flex-col flex-grow p-5 pt-4">
          <header class="mb-2">
            <a href={`${prefix}/proyects/${proyecto.id}`} tabindex="-1">
              <h3 class="project-title text-xl font-extrabold text-foreground tracking-tight transition-colors duration-200 font-syne leading-tight">
                {proyecto.title}
              </h3>
            </a>
          </header>

          <p class="text-[14px] text-muted-foreground leading-relaxed mb-6 flex-grow font-normal">
            {proyecto.description}
          </p>

          <!-- Tecnologías -->
          <div class="flex flex-wrap gap-2 mb-6">
            {proyecto.technologies.slice(0, 5).map((tech) => (
              <div class="tech-pill flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-muted/60 border border-border transition-colors duration-200 hover:border-amber-500/40">
                <img
                  src={tech.imagen}
                  alt={tech.nombre}
                  class="size-3.5 object-contain"
                />
                <span class="text-[11px] font-semibold text-foreground/80">
                  {tech.nombre}
                </span>
              </div>
            ))}
          </div>

          <!-- Acciones -->
          <div class="flex items-center gap-3 pt-5 border-t border-border">
            {proyecto.liveNow ? (
              <a
                href={proyecto.link}
                target="_blank"
                class="btn-demo group/btn flex-1 inline-flex items-center justify-center gap-2 font-bold text-[11px] uppercase tracking-[0.2em] transition-transform duration-200 hover:scale-[1.02] active:scale-95"
              >
                <Demo class="size-3.5 transition-transform duration-200 group-hover/btn:translate-x-0.5" />
                <span>Demo</span>
              </a>
            ) : (
              <div class="flex-1 inline-flex items-center justify-center gap-2 py-2.5 bg-muted/50 text-muted-foreground/50 rounded-md font-bold text-[11px] uppercase tracking-[0.2em] cursor-not-allowed">
                <Demo class="size-3.5 opacity-40" />
                <span>{t.projectDetail.notAvailable}</span>
              </div>
            )}

            <a
              href={proyecto.github}
              target="_blank"
              class="btn-github p-2.5 rounded-md text-muted-foreground transition-transform duration-200 active:scale-90"
              aria-label="GitHub Repository"
            >
              <Github3 class="size-4.5" />
            </a>
          </div>
        </div>

      </article>
    ))
  }
</div>

<style>
  /* Card base */
  .project-card {
    background: var(--card);
    border-color: var(--border);
  }
  :global(.dark) .project-card {
    background: var(--card);
    border-color: var(--border);
  }
  .project-card:hover {
    border-color: oklch(0.65 0.18 40 / 0.45);
    box-shadow: 0 12px 40px oklch(0.65 0.18 40 / 0.08);
  }
  :global(.dark) .project-card:hover {
    border-color: oklch(0.72 0.17 44 / 0.45);
    box-shadow: 0 12px 40px oklch(0.65 0.18 40 / 0.16);
  }

  /* Título */
  .project-card:hover .project-title {
    color: oklch(0.55 0.16 36);
  }
  :global(.dark) .project-card:hover .project-title {
    color: oklch(0.72 0.17 44);
  }

  /* Botón Demo */
  .btn-demo {
    padding: 0.625rem 1.25rem;
    background: oklch(0.72 0.17 44);
    color: oklch(0.10 0.012 38);
    border-radius: 0.375rem;
  }
  :global(.dark) .btn-demo {
    background: oklch(0.72 0.17 44);
    color: oklch(0.10 0.012 38);
  }
  .btn-demo:hover {
    background: oklch(0.64 0.17 42);
    color: oklch(0.10 0.012 38);
  }
  :global(.dark) .btn-demo:hover {
    background: oklch(0.64 0.17 42);
  }

  /* Botón GitHub */
  .btn-github {
    background: var(--muted);
    border: 1px solid var(--border);
  }
  :global(.dark) .btn-github {
    background: var(--muted);
    border-color: var(--border);
  }
  .btn-github:hover {
    color: oklch(0.65 0.18 40);
    border-color: oklch(0.65 0.18 40 / 0.4);
  }
  :global(.dark) .btn-github:hover {
    color: oklch(0.72 0.17 44);
    border-color: oklch(0.72 0.17 44 / 0.4);
  }
</style>
