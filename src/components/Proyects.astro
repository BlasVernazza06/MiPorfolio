---
import { getCollection } from 'astro:content'
import Github3 from './icons/github3.astro'
import Demo from './icons/Demo.astro'

const proyectsRaw = await getCollection('proyects')
// Filtrar solo los proyectos visibles
const proyectsVisible = proyectsRaw.filter(item => item.data.visible !== false)
proyectsVisible.sort((a, b) => a.data.order - b.data.order)
const proyects = proyectsVisible.map((item) => ({
    ...item.data,
    id: item.id
}))
---

<div class="grid grid-cols-1 lg:grid-cols-2 gap-10">
    {proyects.map((proyecto) => (
        <article 
            class="group relative flex flex-col h-full rounded-[2.5rem] bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 overflow-hidden transition-all duration-500 hover:-translate-y-2 hover:shadow-2xl hover:shadow-emerald-500/10"
        >
            <!-- Project Image Container -->
            <a href={`/proyects/${proyecto.id}`} class="block relative overflow-hidden aspect-video mx-4 mt-4 rounded-[1.8rem]">
                <img 
                    src={proyecto.imgInicio} 
                    alt={proyecto.title} 
                    class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                    transition:name={`img-${proyecto.id}`}
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
                
                <!-- Status Badge (Floating) -->
                <div class="absolute top-4 right-4 flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-white/20 backdrop-blur-md border border-white/20 text-white text-[10px] font-bold uppercase tracking-widest">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                    Live Now
                </div>
            </a>

            <!-- Content Area -->
            <div class="flex flex-col flex-grow p-8">
                <header class="mb-4">
                    <a href={`/proyects/${proyecto.id}`}>
                        <h3 
                            class="text-2xl font-bold text-zinc-900 dark:text-zinc-50 group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors duration-300 font-outfit"
                            transition:name={`title-${proyecto.id}`}
                        >
                            {proyecto.title}
                        </h3>
                    </a>
                </header>

                <p class="text-zinc-600 dark:text-zinc-400 leading-relaxed mb-8 flex-grow">
                    {proyecto.description}
                </p>

                <!-- Footer: Tech & Links -->
                <div class="space-y-6">
                    <div class="flex flex-wrap gap-2">
                        {proyecto.technologies.slice(0, 4).map((tech) => (
                            <span class="px-3 py-1.5 rounded-xl bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-400 text-xs font-semibold border border-transparent dark:border-zinc-700/50">
                                {tech.nombre}
                            </span>
                        ))}
                    </div>

                    <div class="flex items-center gap-3 pt-4 border-t border-zinc-100 dark:border-zinc-800">
                        <a 
                            href={proyecto.link} 
                            target="_blank" 
                            class="flex-1 inline-flex items-center justify-center gap-2 px-6 py-3 bg-zinc-900 dark:bg-zinc-50 text-white dark:text-zinc-900 rounded-2xl font-bold text-sm transition-all duration-300 hover:scale-[1.02] active:scale-95"
                        >
                            <Demo class="size-4"/>
                            <span>Ver Demo</span>
                        </a>
                        
                        <a 
                            href={proyecto.github} 
                            target="_blank" 
                            class="inline-flex items-center justify-center p-3 text-zinc-600 dark:text-zinc-400 bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-2xl transition-all duration-300 hover:bg-zinc-50 dark:hover:bg-zinc-800 hover:scale-105"
                            aria-label="GitHub Repository"
                        >
                            <Github3 class="size-6"/>
                        </a>
                    </div>
                </div>
            </div>
        </article>
    ))}
</div>

<style>
    /* Animaciones personalizadas que no están en Tailwind base */
    @keyframes slideInUp {
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @keyframes techSlideIn {
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @keyframes float1 {
        0%, 100% {
            transform: translateY(0) rotate(0deg);
            opacity: 0;
        }
        50% {
            transform: translateY(-10px) rotate(180deg);
            opacity: 0.6;
        }
    }

    @keyframes float2 {
        0%, 100% {
            transform: translateX(0) rotate(0deg);
            opacity: 0;
        }
        50% {
            transform: translateX(-20px) rotate(180deg);
            opacity: 0.4;
        }
    }

    @keyframes float3 {
        0%, 100% {
            transform: translate(0, 0) rotate(0deg);
            opacity: 0;
        }
        50% {
            transform: translate(-10px, -10px) rotate(180deg);
            opacity: 0.5;
        }
    }

    /* Efecto 3D personalizado - solo en dispositivos medianos+ */
    @media (min-width: 768px) {
        .project-card:hover {
            transform: perspective(1000px) translateY(-10px) rotateX(5deg) rotateY(5deg);
        }
        
        /* Activar animaciones de partículas en hover */
        .project-card:hover .particle {
            animation-play-state: running;
        }
    }

    /* En móviles, efecto hover más simple */
    @media (max-width: 767px) {
        .project-card:active {
            transform: scale(0.98);
        }
    }
</style>