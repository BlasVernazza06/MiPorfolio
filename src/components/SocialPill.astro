---
import type { HTMLAttributes } from 'astro/types';
import { cn } from "@/lib/utils";

interface Props extends HTMLAttributes<'a'> {}

const { class: className, ...rest } = Astro.props;
---

<a 
    {...rest}
    target="_blank"
    class={cn(
      "inline-flex items-center justify-center gap-2 px-4 py-2 text-sm font-medium rounded-lg border border-border bg-card text-card-foreground transition-transform duration-200 hover:scale-105 active:scale-95 focus-visible:ring-2 focus-visible:ring-ring cursor-pointer",
      className
    )}
>
    <slot />
</a>