---
import Layout from '@/layouts/Layout.astro';
import Skills from '@/components/Skills.astro'
import About from '@/components/About.astro'
import Certifies from '@/components/Certifies.astro'
import SectionContainer from '@/components/SectionContainer.astro';
import TitleSection from '@/components/TitleSection.astro'
import Start from '@/components/Start.astro'
import Proyects from '@/components/Proyects.astro'
import Experience from '@/components/Experience.astro'
import Contact from '@/components/Contact.astro'
import { getTranslations } from '@/lib/i18n';

const lang = "en";
const t = getTranslations(lang);
---

<Layout title="Blas Vernazza | Portfolio" lang={lang}>
	<main class="flex flex-col px-6">
		<SectionContainer id="Inicio" class="pt-16 pb-20 md:pt-24 md:pb-32 lg:pt-32">
			<Start lang={lang}/>
		</SectionContainer>
		
		<div class="space-y-32 md:space-y-48 lg:space-y-64 pb-20 md:pb-32">
			<SectionContainer id="Proyects" class="reveal">
				<TitleSection>
					{t.nav.proyectos}
				</TitleSection>
				<Proyects lang={lang} />
			</SectionContainer>

			<SectionContainer id="Experiencia" class="reveal">
				<TitleSection>
					{t.nav.experiencia}
				</TitleSection>
				<Experience lang={lang}/>
			</SectionContainer>

			<SectionContainer id="Skills" class="reveal">
				<TitleSection>
					{t.skills.title}
				</TitleSection>
				<Skills lang={lang}/>
			</SectionContainer>

			<SectionContainer id="Sobre-mi" class="reveal">
				<TitleSection>
					{t.about.title}
				</TitleSection>
				<About lang={lang}/>
			</SectionContainer>

			<SectionContainer id="Certificados" class="reveal">
				<TitleSection>
					{t.certifies.title}
				</TitleSection>
				<Certifies lang={lang}/>
			</SectionContainer>

			<SectionContainer id="Contacto" class="reveal">
				<Contact lang={lang}/>
			</SectionContainer>
		</div>
	</main>
</Layout>
