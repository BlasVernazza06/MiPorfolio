---
import { getCollection, render } from "astro:content";
import Layout from "../../../layouts/Layout.astro";
import SectionContainer from "../../../components/SectionContainer.astro";
import Github3 from "../../../components/icons/github3.astro";
import Demo from "../../../components/icons/Demo.astro";
import { getTranslations } from "../../../lib/i18n";

export async function getStaticPaths() {
  const proyects = await getCollection("proyects");
  const enProyects = proyects.filter((p) => p.id.startsWith("en/"));
  return enProyects.map((proyect) => ({
    params: { id: proyect.id.replace("en/", "") },
    props: { proyect },
  }));
}

const { proyect } = Astro.props;
const { title, description, imgInicio, link, github, technologies, otherTechnologies, liveNow } =
  proyect.data;
const { Content } = await render(proyect);

const lang = "en";
const t = getTranslations(lang);
const prefix = "/en";

// Extrae el color hexadecimal de la clase de color (ej. bg-[#2114F2] -> #2114F2)
const getHexColor = (classStr) => {
  if (!classStr) return '#f97316';
  const match = classStr.match(/#([A-Fa-f0-9]{6}|[A-Fa-f0-9]{3})/);
  return match ? `#${match[1]}` : '#f97316';
};

const themeColor = technologies.length > 0 ? getHexColor(technologies[0].class) : '#f97316';

// Función para determinar si el color es claro (contraste y accesibilidad)
const isLightColor = (hex) => {
  const c = hex.substring(1);      // quitar #
  const rgb = parseInt(c, 16);   // convertir a decimal
  const r = (rgb >> 16) & 0xff;  // componente rojo
  const g = (rgb >> 8) & 0xff;   // componente verde
  const b = (rgb >> 0) & 0xff;   // componente azul
  const luma = 0.2126 * r + 0.7152 * g + 0.0722 * b; // estándar ITU-R BT.709
  return luma > 185; // retorna true si es color claro
};

const isThemeLight = isLightColor(themeColor);

// Clasificación de tecnologías por palabras clave
const getCategoryKey = (techName) => {
  const name = techName.toLowerCase();
  
  const frontendKeywords = [
    'nextjs', 'react', 'astro', 'tailwind', 'gsap', 'html', 'css', 
    'javascript', 'typescript', 'dndkit', 'tiptap', 'motion', 'shadcn',
    'lucide', 'svgl'
  ];
  const backendKeywords = [
    'nestjs', 'java', 'python', 'stripe', 'pusher', 'resend', 
    'better auth', 'uploadthing', 'api', 'fastapi', 'uvicorn', 'langchain', 'brevo'
  ];
  const databaseKeywords = [
    'supabase', 'prisma', 'neon', 'mysql', 'postgresql', 'drizzle', 
    'redis', 'aws s3', 'database', 'sql', 'cache-manager'
  ];

  if (frontendKeywords.some(keyword => name.includes(keyword))) {
    return 'frontend';
  }
  if (backendKeywords.some(keyword => name.includes(keyword))) {
    return 'backend';
  }
  if (databaseKeywords.some(keyword => name.includes(keyword))) {
    return 'database';
  }
  return 'tools'; // fallback para herramientas secundarias
};

// Mapa estructurado de categorías de tecnologías
const categoriesMap = {
  frontend: {
    label: "Frontend & UI",
    class: "border-blue-500/20 dark:border-blue-500/10 text-blue-600 dark:text-blue-400 bg-blue-50/30 dark:bg-blue-950/10",
    technologies: []
  },
  backend: {
    label: "Backend & APIs",
    class: "border-rose-500/20 dark:border-rose-500/10 text-rose-600 dark:text-rose-400 bg-rose-50/30 dark:bg-rose-950/10",
    technologies: []
  },
  database: {
    label: lang === "en" ? "Database & Infrastructure" : "Base de Datos & Infraestructura",
    class: "border-emerald-500/20 dark:border-emerald-500/10 text-emerald-600 dark:text-emerald-400 bg-emerald-50/30 dark:bg-emerald-950/10",
    technologies: []
  },
  tools: {
    label: lang === "en" ? "Tools & DevOps" : "Herramientas & DevOps",
    class: "border-amber-500/20 dark:border-amber-500/10 text-amber-600 dark:text-amber-400 bg-amber-50/30 dark:bg-amber-950/10",
    technologies: []
  }
};

// Unificar y etiquetar tecnologías principales y secundarias
const allTech = [
  ...technologies.map(t => ({ ...t, isCore: true })),
  ...(otherTechnologies || []).map(t => ({ ...t, isCore: false }))
];

allTech.forEach(tech => {
  const catKey = getCategoryKey(tech.nombre);
  categoriesMap[catKey].technologies.push(tech);
});

// Filtrar las categorías vacías
const activeCategories = Object.entries(categoriesMap)
  .filter(([_, cat]) => cat.technologies.length > 0)
  .map(([key, cat]) => ({ key, ...cat }));
---

<Layout title={`${title} | Project`} lang={lang}>
  <main class="relative px-6 pt-32 pb-20 overflow-hidden" style={`--theme-color: ${themeColor};`}>
    <!-- Halos de luz de fondo con el color temático del proyecto -->
    <div class="absolute top-0 right-0 -z-20 w-[40rem] h-[40rem] rounded-full bg-[var(--theme-color)] opacity-[0.03] dark:opacity-[0.05] blur-[120px] pointer-events-none"></div>
    <div class="absolute bottom-0 left-0 -z-20 w-[30rem] h-[30rem] rounded-full bg-[var(--theme-color)] opacity-[0.02] dark:opacity-[0.04] blur-[100px] pointer-events-none"></div>

    <SectionContainer class="max-w-5xl">
      <!-- Back Button -->
      <a
        href={`${prefix}/#Proyects`}
        class="inline-flex items-center gap-2 text-zinc-500 transition-colors mb-8 group"
        data-astro-history="back"
        data-astro-prefetch
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="transition-transform group-hover:-translate-x-1"
          ><path d="m15 18-6-6 6-6"></path></svg
        >
        {t.projectDetail.back}
      </a>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
        <!-- Columna 1: Presentación de la Imagen del Proyecto -->
        <div class="relative group">
          <!-- Halo trasero de color temático en hover -->
          <div class="absolute -inset-4 rounded-[2.5rem] bg-[var(--theme-color)] opacity-15 dark:opacity-25 blur-2xl group-hover:opacity-25 dark:group-hover:opacity-35 transition-opacity duration-500 -z-10"></div>
          
          <!-- Textura de fondo (cuadrícula sutil) -->
          <div class="absolute inset-0 -z-10 rounded-[2.5rem] bg-[linear-gradient(to_right,#8080800d_1px,transparent_1px),linear-gradient(to_bottom,#8080800d_1px,transparent_1px)] bg-[size:14px_24px]"></div>

          <!-- Marco de la imagen con diseño premium -->
          <div
            class="relative overflow-hidden rounded-[2.5rem] border border-zinc-200/80 dark:border-zinc-800/80 shadow-2xl aspect-video bg-zinc-100 dark:bg-zinc-900"
          >
            <img
              src={imgInicio}
              alt={title}
              class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.03]"
            />
            
            <!-- Efecto Sweep/Brillo sobre la imagen en hover -->
            <div class="absolute inset-0 bg-gradient-to-r from-transparent via-white/10 to-transparent -translate-x-full group-hover:animate-shimmer pointer-events-none"></div>
            
            <!-- Insignia "En Vivo" flotante -->
            <div class="absolute top-4 left-4 flex gap-2">
              {liveNow && (
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider bg-emerald-500/90 text-white backdrop-blur-md shadow-lg shadow-emerald-500/20">
                  <span class="size-1.5 rounded-full bg-white animate-pulse"></span>
                  {t.projectDetail.live}
                </span>
              )}
            </div>
          </div>
        </div>

        <!-- Columna 2: Título del Proyecto, Descripción y Botones -->
        <div class="space-y-8 lg:pl-4">
          <div>
            <h1
              class="text-4xl md:text-5xl font-extrabold text-zinc-900 dark:text-white font-syne mb-4 tracking-tight leading-none"
            >
              {title}
            </h1>
            <p class="text-sm md:text-base text-zinc-600 dark:text-zinc-400 leading-relaxed font-normal">
              {description}
            </p>
          </div>

          <!-- Botones de Acción (Demo y Código) -->
          <div class="flex items-center gap-4 pt-4">
            {
              liveNow ? (
                <a
                  href={link}
                  target="_blank"
                  class={`flex-1 inline-flex items-center justify-center gap-2 px-6 py-4 rounded-2xl font-bold transition-all duration-300 hover:scale-[1.02] active:scale-[0.98] shadow-xl ${isThemeLight ? 'text-zinc-900' : 'text-white'}`}
                  style={`background: linear-gradient(135deg, var(--theme-color), ${themeColor}dd); box-shadow: 0 10px 25px -5px ${themeColor}40;`}
                >
                  <Demo class="size-5" />
                  {t.projectDetail.demo}
                </a>
              ) : (
                <div class="flex-1 inline-flex items-center justify-center gap-2 px-6 py-4 bg-zinc-100 dark:bg-zinc-900 text-zinc-400 dark:text-zinc-600 border border-zinc-200/50 dark:border-zinc-800/80 rounded-2xl font-bold cursor-not-allowed">
                  <Demo class="size-5 opacity-50" />
                  {t.projectDetail.notAvailable}
                </div>
              )
            }
            <a
              href={github}
              target="_blank"
              class="p-4 bg-zinc-100 dark:bg-zinc-900 text-zinc-900 dark:text-white border border-zinc-200/65 dark:border-zinc-800/80 rounded-2xl transition-all duration-300 hover:scale-105 hover:bg-zinc-200 dark:hover:bg-zinc-800"
              title={t.projectDetail.code}
            >
              <Github3 class="size-6" />
            </a>
          </div>
        </div>
      </div>

      <!-- Stack Tecnológico Categorizado por Tipo -->
      <div class="mt-16 space-y-6">
        <h3 class="text-xs font-bold uppercase tracking-widest text-zinc-400 dark:text-zinc-500">
          {t.projectDetail.techStack}
        </h3>
        
        <div class="space-y-5">
          {
            activeCategories.map((cat, catIdx) => (
              <div 
                class="space-y-3 animate-fade-in-up" 
                style={`animation-delay: ${catIdx * 100}ms;`}
              >
                <!-- Título de Categoría con Separador Técnico -->
                <div class="flex items-center gap-3">
                  <span class={`inline-flex items-center px-2.5 py-0.5 rounded-md text-[9px] font-extrabold uppercase tracking-wider border ${cat.class}`}>
                    {cat.label}
                  </span>
                  <div class="h-[1px] flex-1 bg-zinc-100 dark:bg-zinc-800/85"></div>
                </div>
                
                <!-- Lista de Tarjetas de Tecnologías (en horizontal) -->
                <div class="flex flex-wrap gap-2.5">
                  {
                    cat.technologies.map((tech) => {
                      const color = getHexColor(tech.class);
                      return (
                        <div
                          class="group relative flex items-center gap-2 px-3.5 py-2.5 rounded-xl bg-white dark:bg-zinc-950 border border-zinc-200/70 dark:border-zinc-900 transition-all duration-300 hover:-translate-y-0.5 hover:shadow-md hover:shadow-[var(--shadow-color)] hover:border-[var(--border-color)]"
                          style={`--shadow-color: ${color}15; --border-color: ${color}; --accent-color: ${color};`}
                        >
                          <!-- Glow Radial al hacer hover sobre la tarjeta -->
                          <div 
                            class="absolute inset-0 -z-10 rounded-xl opacity-0 group-hover:opacity-100 transition-opacity duration-300 bg-[radial-gradient(circle_at_center,var(--glow-color)_0%,transparent_70%)]" 
                            style={`--glow-color: ${color}0d;`}
                          />
                          
                          <img
                            src={tech.imagen}
                            alt={tech.nombre}
                            class="size-5 object-contain transition-transform duration-300 group-hover:scale-110"
                          />
                          <span class="text-xs font-semibold text-zinc-700 dark:text-zinc-300 group-hover:text-zinc-900 dark:group-hover:text-white transition-colors duration-300">
                            {tech.nombre}
                          </span>
                          
                          {tech.isCore && (
                            <span 
                              class="text-[8px] font-extrabold uppercase tracking-wider px-1.5 py-0.5 rounded bg-zinc-100 dark:bg-zinc-900 text-zinc-400 dark:text-zinc-500 border border-zinc-200/50 dark:border-zinc-800/80"
                            >
                              {t.projectDetail.core}
                            </span>
                          )}
                        </div>
                      );
                    })
                  }
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <!-- Divisor Decorativo Central -->
      <div class="relative flex items-center justify-center my-20">
        <div class="absolute inset-0 flex items-center" aria-hidden="true">
          <div class="w-full border-t border-zinc-200 dark:border-zinc-850"></div>
        </div>
        <div class="relative bg-white dark:bg-zinc-950 px-4 text-zinc-350 dark:text-zinc-700">
          <svg class="size-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
          </svg>
        </div>
      </div>

      <!-- Contenedor del Artículo con Ancho Optimizado de Lectura -->
      <div class="max-w mx-auto">
        <article
          class="prose dark:prose-invert max-w-none prose-emerald prose-headings:font-syne prose-headings:font-bold prose-p:text-zinc-600 dark:prose-p:text-zinc-400 prose-p:text-lg prose-p:leading-relaxed"
        >
          <Content />
        </article>
      </div>
    </SectionContainer>
  </main>
</Layout>

<style is:global>
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in-up {
    opacity: 0;
    animation: fadeInUp 0.7s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes shimmer {
    100% {
      transform: translateX(100%);
    }
  }
  .group:hover .group-hover\:animate-shimmer {
    animation: shimmer 1.2s ease-out;
  }

  /* Estilos prose personalizados para el artículo */
  .prose h2 {
    font-family: var(--font-syne), "Syne", sans-serif;
    font-weight: 800;
    font-size: 1.5rem;
    line-height: 2rem;
    margin-top: 3rem;
    margin-bottom: 1.5rem;
    padding-bottom: 0.5rem;
    letter-spacing: -0.025em;
    border-bottom: 1px solid var(--border);
    color: var(--foreground);
  }
  @media (min-width: 768px) {
    .prose h2 {
      font-size: 1.875rem;
      line-height: 2.25rem;
    }
  }

  .prose h3 {
    font-family: var(--font-syne), "Syne", sans-serif;
    font-weight: 700;
    font-size: 1.25rem;
    line-height: 1.75rem;
    margin-top: 2rem;
    margin-bottom: 1rem;
    letter-spacing: -0.025em;
    color: var(--foreground);
  }

  .prose p {
    margin-bottom: 1.5rem;
    font-size: 0.875rem;
    line-height: 1.625;
    color: var(--muted-foreground);
  }
  @media (min-width: 768px) {
    .prose p {
      font-size: 1rem;
      line-height: 1.75;
    }
  }

  .prose ul {
    list-style-type: disc;
    padding-left: 1.5rem;
    margin-bottom: 1.5rem;
    color: var(--muted-foreground);
    font-size: 0.875rem;
    line-height: 1.625;
  }
  @media (min-width: 768px) {
    .prose ul {
      font-size: 1rem;
    }
  }
  .prose ul > li + li {
    margin-top: 0.75rem;
  }

  .prose ol {
    list-style-type: decimal;
    padding-left: 1.5rem;
    margin-bottom: 1.5rem;
    color: var(--muted-foreground);
    font-size: 0.875rem;
    line-height: 1.625;
  }
  @media (min-width: 768px) {
    .prose ol {
      font-size: 1rem;
    }
  }
  .prose ol > li + li {
    margin-top: 0.75rem;
  }

  .prose li::marker {
    color: var(--primary);
  }

  .prose strong {
    font-weight: 800;
    color: var(--primary);
  }

  .prose blockquote {
    padding-left: 1.5rem;
    padding-top: 0.5rem;
    padding-bottom: 0.5rem;
    padding-right: 1rem;
    border-left: 4px solid var(--primary);
    font-style: italic;
    color: var(--foreground);
    background-color: var(--muted);
    border-top-right-radius: 0.75rem;
    border-bottom-right-radius: 0.75rem;
    margin-top: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .prose code {
    background-color: var(--muted);
    color: var(--foreground);
    padding: 0.125rem 0.375rem;
    border-radius: 0.25rem;
    font-size: 0.875rem;
    font-family: monospace;
    font-weight: 600;
  }

  .prose code::before, .prose code::after {
    content: "" !important;
  }

  .prose pre {
    background-color: oklch(0.12 0.014 38);
    color: #f4f4f5;
    padding: 1rem;
    border-radius: 1rem;
    overflow-x: auto;
    border: 1px solid var(--border);
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.1);
    margin-top: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .prose pre code {
    background-color: transparent !important;
    padding: 0 !important;
    border-radius: 0 !important;
    color: #f4f4f5;
    font-weight: 400;
  }
</style>
