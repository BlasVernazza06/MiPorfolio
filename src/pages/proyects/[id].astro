---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import SectionContainer from "../../components/SectionContainer.astro";
import Github3 from "../../components/icons/github3.astro";
import Demo from "../../components/icons/Demo.astro";

export async function getStaticPaths() {
  const proyects = await getCollection("proyects");
  return proyects.map((proyect) => ({
    params: { id: proyect.id },
    props: { proyect },
  }));
}

const { proyect } = Astro.props;
const { title, description, imgInicio, link, github, technologies, liveNow } =
  proyect.data;
const { Content } = await render(proyect);
---

<Layout title={`${title} | Proyecto`}>
  <main class="px-6 pt-32 pb-20">
    <SectionContainer class="max-w-5xl">
      <!-- Back Button -->
      <a
        href="/#Proyects"
        class="inline-flex items-center gap-2 text-zinc-500 dark:text-zinc-400 hover:text-emerald-500 transition-colors mb-8 group"
        data-astro-history="back"
        data-astro-prefetch
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="transition-transform group-hover:-translate-x-1"
          ><path d="m15 18-6-6 6-6"></path></svg
        >
        Volver a Proyectos
      </a>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
        <!-- Project Image -->
        <div
          class="relative group rounded-[2.5rem] overflow-hidden border border-zinc-200 dark:border-zinc-800 shadow-2xl aspect-video"
        >
          <img
            src={imgInicio}
            alt={title}
            class="w-full h-full object-cover"
          />
        </div>

        <!-- Project Info -->
        <div class="space-y-8">
          <div>
            <h1
              class="text-4xl md:text-5xl font-extrabold text-zinc-900 dark:text-white font-outfit mb-4"
            >
              {title}
            </h1>
            <p class="text-lg text-zinc-600 dark:text-zinc-400 leading-relaxed">
              {description}
            </p>
          </div>

          <!-- Technologies -->
          <div class="space-y-4">
            <h3
              class="text-sm font-bold uppercase tracking-widest text-zinc-400"
            >
              Stack Tecnológico
            </h3>
            <div class="flex flex-wrap gap-3">
              {
                technologies.map((tech) => (
                  <div class="flex items-center gap-2 px-3 py-2 rounded-xl bg-white dark:bg-zinc-900 border border-zinc-100 dark:border-zinc-800 shadow-sm">
                    <img
                      src={tech.imagen}
                      alt={tech.nombre}
                      class="size-5 object-contain"
                    />
                    <span class="text-xs font-semibold text-zinc-700 dark:text-zinc-300">
                      {tech.nombre}
                    </span>
                  </div>
                ))
              }
            </div>
          </div>

          <!-- Links -->
          <div class="flex items-center gap-4 pt-4">
            {
              liveNow ? (
                <a
                  href={link}
                  target="_blank"
                  class="flex-1 inline-flex items-center justify-center gap-2 px-6 py-4 bg-emerald-500 text-white rounded-2xl font-bold transition-all hover:bg-emerald-600 hover:scale-[1.02] shadow-xl shadow-emerald-500/20"
                >
                  <Demo class="size-5" />
                  Ver Demo En Vivo
                </a>
              ) : (
                <div class="flex-1 inline-flex items-center justify-center gap-2 px-6 py-4 bg-zinc-200 dark:bg-zinc-800 text-zinc-500 dark:text-zinc-500 rounded-2xl font-bold cursor-not-allowed">
                  <Demo class="size-5 opacity-50" />
                  Demo no disponible
                </div>
              )
            }
            <a
              href={github}
              target="_blank"
              class="p-4 bg-zinc-100 dark:bg-zinc-800 text-zinc-900 dark:text-white rounded-2xl transition-all hover:scale-110"
              title="Ver Código en GitHub"
            >
              <Github3 class="size-6" />
            </a>
          </div>
        </div>
      </div>

      <!-- Article Content -->
      <article
        class="mt-20 prose dark:prose-invert max-w-none prose-emerald prose-headings:font-outfit prose-headings:font-bold prose-p:text-zinc-600 dark:prose-p:text-zinc-400 prose-p:text-lg prose-p:leading-relaxed"
      >
        <Content />
      </article>
    </SectionContainer>
  </main>
</Layout>

<style is:global>
  @reference "../../styles/global.css";

  /* Custom prose styles for a blog-like feel */
  .prose h2 {
    @apply text-3xl mt-12 mb-6 border-b border-zinc-100 dark:border-zinc-800 pb-2;
  }
  .prose p {
    @apply mb-6;
  }
  .prose ul {
    @apply list-disc list-inside space-y-2 mb-6 text-zinc-600 dark:text-zinc-400;
  }
</style>
