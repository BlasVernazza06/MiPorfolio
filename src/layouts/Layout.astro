---
import "@/styles/global.css";
import { ClientRouter } from "astro:transitions";
import Header from "@/components/Navbar.astro";
import Footer from "@/components/Footer.astro";
import Aside from "@/components/Aside.astro";
import CommandPalette from "@/components/CommandPalette.astro";
const { title, lang = "es" } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <!-- Language Detection & Redirection -->
    <script is:inline>
      (function() {
        const path = window.location.pathname;
        const isRoot = path === "/" || path === "/index.html";
        
        // Sync direct navigations
        if (path.startsWith("/en")) {
          localStorage.setItem("preferred-language", "en");
          return;
        } else if (isRoot) {
          const preferredLanguage = localStorage.getItem("preferred-language");
          const systemLanguage = navigator.languages ? navigator.languages[0] : navigator.language;

          if (!preferredLanguage) {
            if (systemLanguage.toLowerCase().startsWith("en")) {
              localStorage.setItem("preferred-language", "en");
              window.location.href = "/en/";
            } else {
              localStorage.setItem("preferred-language", "es");
            }
          } else if (preferredLanguage === "en") {
            window.location.href = "/en/";
          }
        }
      })();
    </script>

    <!-- Theme Initialization Script -->
    <script is:inline>
      const getTheme = () => {
        if (typeof localStorage !== "undefined" && localStorage.getItem("theme")) {
          return localStorage.getItem("theme");
        }
        return window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
      };

      const applyTheme = (doc) => {
        const theme = getTheme();
        const isDark = theme === "dark";
        doc.documentElement.classList.toggle("dark", isDark);
      };

      // Inicialización inmediata
      applyTheme(document);

      // Persistencia durante la transición
      document.addEventListener("astro:before-swap", (event) => {
        // Aplicamos el tema al NUEVO documento antes de que se muestre
        applyTheme(event.newDocument);
      });
    </script>

    <!-- Background Safeguard -->
    <style is:inline>
      html.dark {
        background-color: #1a1008;
      }
      html {
        background-color: #fdf8f3;
      }
    </style>

    <link rel="icon" type="image/svg+xml" href="/TechIcons/icons-Web.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <ClientRouter />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700;800&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,300;1,9..40,400&display=swap"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700;800&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,300;1,9..40,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body
    class="text-foreground bg-background selection:bg-amber-500/25 dark:selection:bg-amber-500/30 overflow-x-hidden transition-colors duration-300"
  >
    <!-- Scroll Progress Bar -->
    <div
      id="progress-bar"
      class="fixed top-0 left-0 h-[2px] z-[9999] transition-all duration-300 pointer-events-none"
      style="width: 0%; background: linear-gradient(to right, oklch(0.72 0.17 44), oklch(0.55 0.16 36));"
      transition:persist
    >
    </div>

    <!-- Global Background & Immersive Effects -->
    <div
      class="fixed inset-0 z-[-1] overflow-hidden pointer-events-none"
      transition:persist
    >
      <!-- Base Color Base -->
      <div class="absolute inset-0 bg-background"></div>

      <!-- Mesh Gradients — Orange Ember Atmosphere (muy sutiles) -->
      <div class="absolute inset-0 pointer-events-none">
        <!-- Orbe principal — naranja cálido superior derecha -->
        <div class="absolute top-[-20%] right-[-10%] w-[60%] h-[70%] rounded-full animate-blob-slow" style="background: radial-gradient(circle, oklch(0.72 0.17 44 / 0.10) 0%, transparent 60%); filter: blur(60px);"></div>
        <!-- Orbe secundario — ámbar inferior izquierda -->
        <div class="absolute bottom-[-15%] left-[-10%] w-[55%] h-[60%] rounded-full animate-blob-slow animation-delay-2000" style="background: radial-gradient(circle, oklch(0.55 0.16 36 / 0.07) 0%, transparent 60%); filter: blur(70px);"></div>
      </div>

      <!-- Noise Texture for tactile feel -->
      <div class="absolute inset-0 opacity-[0.02] dark:opacity-[0.03] mix-blend-overlay pointer-events-none" style="background-image: url('https://grainy-gradients.vercel.app/noise.svg');"></div>
    
    </div>

    <Aside lang={lang} />
    <Header lang={lang} />
    <CommandPalette lang={lang} />
    <main class="relative pt-14">
      <slot />
    </main>
    <Footer lang={lang} />

    <style is:global>
      :root {
        color-scheme: light dark;
      }

      /* Focus Outline accessibility */
      *:focus-visible {
        outline: 2px solid oklch(0.72 0.17 44);
        outline-offset: 4px;
      }

      /* View Transitions: Quitamos la animación de salida */
      ::view-transition-old(root) {
        animation: none;
        display: none;
      }

      /* Opcional: Ajustamos la velocidad de entrada para que se sient más "pro" */
      ::view-transition-new(root) {
        animation-duration: 0.4s;
        animation-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        font-family: "DM Sans", sans-serif;
        min-height: 100dvh;
        overscroll-behavior: none;
        -webkit-font-smoothing: antialiased;
        font-optical-sizing: auto;
      }

      h1,
      h2,
      h3,
      h4,
      h5,
      h6 {
        font-family: "Syne", sans-serif;
        letter-spacing: -0.025em;
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }
      }

      #header-nav {
        animation: blur linear both 0.5s;
        animation-timeline: scroll();
        animation-range: 0 500px;
      }

      @keyframes blur {
        to {
          backdrop-filter: blur(16px);
          background-color: rgba(255, 255, 255, 0.7);
          border: 1px solid rgba(0, 0, 0, 0.05);
          box-shadow: 0 4px 30px rgba(0, 0, 0, 0.1);
        }
      }

      .dark #header-nav {
        animation: blur-dark linear both 0.5s;
        animation-timeline: scroll();
        animation-range: 0 500px;
      }

      @keyframes blur-dark {
        to {
          backdrop-filter: blur(16px);
          background-color: rgba(0, 0, 0, 0.6);
          border: 1px solid rgba(255, 255, 255, 0.1);
          box-shadow: 0 4px 30px rgba(0, 0, 0, 0.5);
        }
      }

      /* Reveal Animation: Solo opacidad para evitar saltos de layout */
      .reveal {
        opacity: 0;
        transition: opacity 0.8s cubic-bezier(0.22, 1, 0.36, 1);
      }

      .reveal.active {
        opacity: 1;
      }

      /* Custom Scrollbar */
      ::-webkit-scrollbar {
        width: 6px;
      }
      ::-webkit-scrollbar-track {
        background: transparent;
      }
      ::-webkit-scrollbar-thumb {
        background: oklch(0.65 0.18 40 / 0.3);
        border-radius: 20px;
      }
      ::-webkit-scrollbar-thumb:hover {
        background: oklch(0.72 0.17 44 / 0.5);
      }
      ::selection {
        background: oklch(0.72 0.17 44 / 0.25);
      }

      /* Background Animations */
      @keyframes blob-slow {
        0%,
        100% {
          transform: translate(0px, 0px) scale(1);
        }
        33% {
          transform: translate(30px, -50px) scale(1.1);
        }
        66% {
          transform: translate(-20px, 20px) scale(0.9);
        }
      }

      .animate-blob-slow {
        animation: blob-slow 15s infinite alternate ease-in-out;
      }

      .animation-delay-2000 {
        animation-delay: 2s;
      }

      .animation-delay-4000 {
        animation-delay: 4s;
      }
    </style>

    <script>
      let isMouseListenerActive = false;

      function init() {
        // Intersection Observer for Reveal
        const observerOptions = { threshold: 0.1 };
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("active");
            }
          });
        }, observerOptions);

        const revealElements = document.querySelectorAll(".reveal");
        
        // Detectamos si es una navegación interna (Astro) para evitar el salto de 30px
        const isAstroNav = !!document.documentElement.getAttribute('data-astro-transition');

        // On transition, if we're going to a hash, back or it's an Astro transition, show immediately
        const isBackNav = (window as any).navigation?.activation?.navigationType === "back-forward";
        const hasHash = window.location.hash;

        revealElements.forEach((el) => {
          if (isBackNav || hasHash || isAstroNav) {
            el.classList.add("active");
          }
          observer.observe(el);
        });

        // Scroll Progress Bar
        const progressBar = document.getElementById("progress-bar");
        const updateProgress = () => {
          if (!progressBar) return;
          const winScroll = document.documentElement.scrollTop;
          const height =
            document.documentElement.scrollHeight -
            document.documentElement.clientHeight;
          const scrolled = (winScroll / height) * 100;
          progressBar.style.width = scrolled + "%";
        };

        window.addEventListener("scroll", updateProgress);

        // Cursor Effects
        if (!isMouseListenerActive) {
          document.addEventListener("mousemove", (e) => {
            const spotlight = document.getElementById("cursor-spotlight");
            const dots = document.getElementById("global-dots");
            
            if (spotlight) {
              spotlight.style.setProperty("--x", `${e.clientX}px`);
              spotlight.style.setProperty("--y", `${e.clientY}px`);
              spotlight.style.opacity = "1";
            }

            if (dots) {
              const x = (e.clientX / window.innerWidth - 0.5) * 20;
              const y = (e.clientY / window.innerHeight - 0.5) * 20;
              dots.style.transform = `translate(${x}px, ${y}px)`;
            }
          });
          isMouseListenerActive = true;
        }
      }

      // Initialize on first load and after every View Transition
      document.addEventListener("astro:page-load", init);
    </script>
  </body>
</html>
